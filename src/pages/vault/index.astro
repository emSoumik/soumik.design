---
// the vault: shaders, components and experiments, one canvas each, every one running live. the newest goes on top.
// the dock is the case study's live dock as it is (tour, notes and all), so the two never drift apart
import Base from '../../layouts/Base.astro';
import Item from '../../components/vault/Item.astro';
import Shader from '../../components/vault/Shader.astro';
import DockLive from '../projects/_prototype-whyclub/DockLive.astro';

const CASE = '/projects/whyclub/';
const PASS = 'https://prototype.whyclub.in/';
const BUILT = 'https://prototype.whyclub.in/case-study/';
// PROTOTYPE: in dev the vault is the wall in _prototype/; production renders the page below as it is
const Lab = import.meta.env.DEV ? (await import('./_prototype/VaultLab.astro')).default : null;
---
<Base title="Vault" description="Shaders, components and experiments by Soumik Halder, each one running live, with how it works and why it exists.">
  {Lab ? <Lab /> : <div class="wide-col">
    <header class="index-head">
      <p class="eyebrow">shaders, components, experiments</p>
      <h1>Vault</h1>
      <p>The small things I build along the way. Each one runs live here. Watch it, try it, then open it to see how it works and why it exists.</p>
    </header>

    <ol class="vault">
      <Item
        n="01" id="dock" kind="Component" from="WhyClub" title="The dock"
        line="WhyClub’s navigation: one piece at the bottom of the screen that is a pill, a bar or a panel, depending on where you are."
        links={[['WhyClub case study', CASE], ['whyclub.in', 'https://whyclub.in']]}
        how={[
          'It’s one shell that morphs between three shapes. At the top of the page it’s a bar. Further down it shrinks to a pill. Tap a tab and it opens into a panel: Shop, Account or More.',
          'Each change is a morph on a spring, not a swap. This is the real component, built from the store and running in a frame. The notes around it are measured from the live dock.',
        ]}
        story={[
          'On WhyClub the navigation lives at the bottom of the screen, where your thumb already is.',
          'Instead of a header and a separate menu, it’s one thing that stays small while you browse and opens up when you ask it to. The tour walks it through each shape until you tap it.',
        ]}
      >
        <div class="dock"><DockLive /></div>
      </Item>

      <Item
        n="02" id="order-pass" kind="Shaders" from="WhyClub drop pass" title="Order pass" tone="ink"
        line="Every WhyClub order gets a pass that changes as the order moves. Each stage has its own light, written by hand in WebGL."
        links={[['How the shaders were built', BUILT], ['Try the drop pass', PASS], ['WhyClub case study', CASE]]}
        how={[
          'One fragment shader draws all four stages. A bloom opens when the order is confirmed, a glowing box bobs once it’s packed, a comet runs the route to a pin when it ships, and a bouquet sits at different depths of focus when it’s home.',
          'Under each scene is a grainy colour field in the stage’s accent, a faint iridescent edge, and a light leak that slides as you tilt. A cosine palette keeps the colour smooth, and dither on top stops the gradients banding. Move your pointer over it to tilt the light.',
        ]}
        story={[
          'A status label says “shipped”. The pass shows it: You’re in, All packed, On its way, It’s home.',
          'The shaders were written for the drop pass, then turned up around the rest of the store. The full write-up of how they were made lives on the prototype site.',
        ]}
      >
        <Shader heads label="Order stage" scenes={[[0, 'Confirmed'], [1, 'Packed'], [2, 'Shipped'], [3, 'Delivered']]} />
      </Item>

      <Item
        n="03" id="riso-and-404" kind="Shaders" from="WhyClub" title="Riso glyphs, an asterisk and a 404" tone="ink"
        line="The same hand-written WebGL around the rest of the store: riso badges for the beta pass, a dithered asterisk, and a 404 where a prism splits the light."
        links={[['How the shaders were built', BUILT], ['WhyClub case study', CASE]]}
        how={[
          'The glyphs are printed like a riso: paper tooth, a faint ink-starved band, then grain. The asterisk’s halo is drawn as 2px ordered-dither dots.',
          'The 404 shines a beam of warm white through a glass prism and fans it into a spectrum. The two 4s are glass too: each colour bends a hair differently at their edges, and unlit glass shows only a faint line. Move your pointer to swing the beam.',
        ]}
        story={[
          'These started with the drop pass and spread. The beta pass got riso badges and a dithered asterisk, and even the 404 got its own light.',
        ]}
      >
        <Shader label="Shader" scenes={[[4, 'Riso glyphs'], [5, 'Dithered asterisk'], [6, '404']]} />
      </Item>
    </ol>
  </div>}
</Base>

<style is:global>
  /* a grey room, so each white canvas reads as its own surface */
  html:has(.vault) { --paper: #f4f4f2; }
</style>
<style>
  .vault { display: grid; gap: clamp(72px, 10vw, 128px); padding: 0; margin: 0; }
  /* the dock brings its own room; give it a little air inside the canvas */
  .dock { padding: clamp(20px, 3vw, 40px) clamp(16px, 3vw, 40px) clamp(12px, 2vw, 24px); }
</style>
