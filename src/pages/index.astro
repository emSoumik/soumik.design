---
import Wordmark from '../components/Wordmark.astro';
import { published } from '../lib/content';
import Fonts from '../components/Fonts.astro';
import Speculation from '../components/Speculation.astro';
import PageTransitions from '../components/transitions/PageTransitions.astro';
import Analytics from '../components/Analytics.astro';
import ProtoHead from '../components/proto/ProtoHead.astro';
import Titles from '../components/Titles.astro';

// the work section links a project to its case study only once that case study is published (a draft would 404 on soumik.design)
const cases = (await published('work')).map((e) => e.id);
---
