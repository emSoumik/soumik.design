<noscript><style is:inline>.wait, skullet-reveal { display: none; }</style></noscript>
<Fonts preload={['pixel']} />
<style is:inline>
  @font-face { font-family: "Faculty Glyphic"; src: url(/assets/fonts/faculty-glyphic.woff2) format("woff2"); font-display: swap; }
  :root {
    --paper: #ffffff; --ink: #1f1d1b; --ink-2: rgba(31, 29, 27, .68); --ink-3: rgba(31, 29, 27, .62); --line: rgba(31, 29, 27, .12);
    --ease: cubic-bezier(.23, 1, .32, 1); --spring: cubic-bezier(.3, 1.4, .5, 1);
    --display: "Instrument Sans", "Instrument Sans fallback", -apple-system, system-ui, sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, monospace; --ui: -apple-system, system-ui, sans-serif;
    --pixel: "Pixelify Sans", "Pixelify Sans fallback", ui-monospace, "SF Mono", Menlo, monospace;
    --gut: clamp(16px, 2.6vw, 36px);
  }
  * { box-sizing: border-box; margin: 0; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { background: var(--paper); color: var(--ink); font: 400 13px/1.45 var(--ui); overflow-x: hidden; overflow-x: clip;
    -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  ::selection { background: #d9def2; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :focus-visible { outline: 1.5px solid currentColor; outline-offset: 4px; border-radius: 6px; }

  /* ---- hero: one screen, the garden, the name, two links */
  .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; }
  /* js hides this for a mouse and draws the pixel arrow itself (garden/cursor.js) */
  #garden { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: pointer; touch-action: manipulation;
    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
  /* the UI floats over the garden; only real controls take the pointer, so every empty spot plants */
  .ui { position: absolute; inset: 0; pointer-events: none; z-index: 10; }
  .ui a, .ui button { pointer-events: auto; }

  .top { position: absolute; left: var(--gut); right: calc(var(--gut) - 12px); top: calc(max(var(--gut), env(safe-area-inset-top)) - 3px); display: flex; justify-content: flex-end; align-items: center; }
  .tr-r { display: flex; align-items: center; }
  @media (pointer: coarse) { .hint { min-height: 44px; } }
  .snd { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 10px; color: var(--ink-2); transition: color .2s, background .2s, transform .16s var(--ease); position: relative; }
    .snd:active { transform: scale(.96); }
  .snd svg { width: 18px; height: 18px; } .snd .x { display: none; }
  .snd[aria-pressed=false] .w1, .snd[aria-pressed=false] .w2 { display: none; } .snd[aria-pressed=false] .x { display: inline; }

  .mark { position: absolute; left: 50%; top: 25svh; translate: -50% 0; }
  /* the wordmark: Instrument Serif italic, with a pixel flower standing in for the i (baked to SVG) */
  .mark h1 { margin: 0; line-height: 0; }
  .wm { width: clamp(320px, 40vw, 600px); height: auto; display: block; overflow: visible; }
  .wm-f rect { shape-rendering: crispEdges; }
  .load .wm-l path { animation: ink 1s var(--ease) both; animation-delay: calc(.3s + var(--i) * 80ms); }
  .load .wm-f rect { animation: stitch .16s linear both; animation-delay: calc(1.05s + var(--k) * 42ms); }
  @keyframes ink { from { opacity: 0; transform: translateY(24px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes stitch { 0% { opacity: 0; } .1% { opacity: 1; fill: #fff3c2; } 50% { fill: #fff3c2; } 100% { opacity: 1; } }
  .wm-l path { transform-box: fill-box; }
  /* small words at the corners of the big one */
  .cw { position: absolute; font: 500 clamp(11px, .95vw, 13px)/1 var(--display); letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
  .cw.tl { left: 6%; top: -2.6em; } .cw.tr { right: 2%; top: -2.6em; } .cw.bl { left: 0; bottom: -2.6em; } .cw.br { right: 0; bottom: -2.6em; }

  /* the dock: about me (yellow), projects, vault, blog, fixed low in the middle so it's there all the way down.
     it arrives quiet, just words on the white; once you scroll it fills in. planting tucks it into the yellow bud,
     out of the garden's way, and a tap on the bud opens it again. --dock is the hero's gap; the hint and clear stack above it */
  :root { --dock: calc(max(22px, calc(env(safe-area-inset-bottom) + 12px)) + max(0px, 560px - 100svh)); --dock-f: max(22px, calc(env(safe-area-inset-bottom) + 12px)); --ios: cubic-bezier(.32, .72, 0, 1); }
  /* its layout never changes: the tuck is a clip that closes round the avatar while it carries the bud to the middle
     (main.js measures --dk-* from the open dock). the clip stands off 40px so the open pill keeps its shadow */
  .nav { position: fixed; z-index: 50; left: 50%; bottom: var(--dock-f); translate: -50% 0; display: flex; align-items: center; padding: 4px; border-radius: 99px;
    font: 500 15px/1 var(--pixel); letter-spacing: .01em; clip-path: inset(-40px round 99px);
    transition: transform .42s var(--ios), clip-path .42s var(--ios); }
  /* the pill's white and lift fade on opacity alone; frosted glass only under a mouse (and on the dock itself: a clip makes it a backdrop root) */
  .nav::before { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none; background: rgba(255, 255, 255, .94);
    box-shadow: 0 0 0 1px rgba(31, 29, 27, .1), 0 16px 36px -18px rgba(31, 29, 27, .5), 0 2px 6px -3px rgba(31, 29, 27, .18); transition: opacity .3s var(--ease); }
  @media (hover: hover) and (pointer: fine) {
    .nav { -webkit-backdrop-filter: blur(12px) saturate(1.4); backdrop-filter: blur(12px) saturate(1.4); }
    .nav::before { background: rgba(255, 255, 255, .86); }
  }
  .nav :is(.me, .seg) { position: relative; white-space: nowrap; display: inline-flex; align-items: center; min-height: 44px; border-radius: 99px; color: var(--ink);
    transition: background-color .3s var(--ease), color .3s var(--ease), transform .16s var(--ease); }
  .nav :is(.me, .seg):active { transform: scale(.96); }
  .nav :is(.me, .seg):focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 99px; }
  .nav .me { padding: 0 18px 0 5px; color: #1f1d1b; isolation: isolate; }
  /* the yellow fill, and the hairline the bud wears once the clip has taken the pill's shadow */
  .nav .me::before, .nav .me::after { content: ""; position: absolute; z-index: -1; border-radius: inherit; pointer-events: none; }
  .nav .me::before { inset: 0; background: #ffd84d; transition: opacity .3s var(--ease); }
  .nav .me::after { left: 0; top: 0; height: 100%; aspect-ratio: 1; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(31, 29, 27, .12); opacity: 0; transition: opacity .15s ease-out; }
  html.tuck .nav .me::after { opacity: 1; transition: opacity .2s var(--ease) .22s; }
  .nav .ic { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; overflow: hidden; }
  .nav .ic picture { display: contents; }
  .nav .ic img { width: 30px; height: 30px; object-fit: contain; mix-blend-mode: multiply; translate: 0 2px; transition: transform .5s var(--spring); }
  .nav .seg { padding: 0 16px; }
  .nav .more .seg + .seg::before { content: ""; position: absolute; left: -2px; top: 13px; bottom: 13px; width: 1px; background: rgba(31, 29, 27, .12); }
  .nav .arr { display: inline-block; margin-left: 6px; transition: transform .4s var(--spring), opacity .2s; }
  .nav [data-work]::after { content: ""; position: absolute; left: 50%; bottom: 7px; width: 4px; height: 4px; margin-left: -2px; background: currentColor; opacity: 0; transition: opacity .2s; }
  html.at-work .nav [data-work]::after { opacity: 1; }
  html.at-work .nav [data-work] .arr { opacity: .35; }
  /* the words come back once the pill has opened, and go first when it closes */
  .nav .more, .nav .lb { display: inline-flex; transition: opacity .2s var(--ease) .12s; }
  .nav .more { gap: 2px; margin-left: 2px; }
  .nav .lb { padding-left: 9px; }
  /* tucked: only the yellow bud */
  html.tuck .nav { transform: translateX(var(--dk-dx, 0px)); clip-path: inset(var(--dk-t, 4px) var(--dk-r, 0px) var(--dk-b, 4px) var(--dk-l, 4px) round 99px); }
  html.tuck .nav :is(.more, .lb) { opacity: 0; transition: opacity .15s ease-out; }
  /* quiet: at the top, before any planting or opening */
  html:not(.moved):not(.open):not(.tuck) .nav { -webkit-backdrop-filter: none; backdrop-filter: none; }
  html:not(.moved):not(.open):not(.tuck) .nav::before, html:not(.moved):not(.open):not(.tuck) .nav .me::before { opacity: 0; }
  html:not(.moved):not(.open):not(.tuck) .nav .seg { color: var(--ink-2); }
  @media (max-width: 640px) {
    .nav { font-size: 13.5px; }
    .nav .seg { padding: 0 11px; }
    .nav .me { padding: 0 13px 0 4px; }
    .nav .lb { padding-left: 6px; }
    .nav .arr { display: none; }
  }
  @media (max-width: 360px) { .nav { font-size: 12.5px; } .nav .seg { padding: 0 8px; } .nav .me { padding-right: 10px; } }
  .foot { padding-bottom: calc(var(--dock-f) + 64px) !important; }
  .hint { position: absolute; left: 50%; bottom: calc(var(--dock) + 68px); translate: -50% 0; font: 400 12px/1 var(--mono); color: var(--ink-2); white-space: nowrap;
    padding: 8px 12px; border-radius: 99px; transition: color .2s, transform .16s var(--ease);
    --tx: -50%; opacity: 0; visibility: hidden; }
  /* it only shows once the garden is built (main.js adds .ready and sets --d), so it never promises taps that do nothing */
  html.ready .hint { visibility: visible; animation: in 1.1s var(--ease) var(--d, 0s) forwards; }
  .hint:active { transform: scale(.97); }
  /* the whole line bobs letter by letter in the garden's colours, like a breeze running along it */
  .hint .fl span { display: inline-block; animation: bob 2.8s var(--ease) infinite; animation-delay: calc(var(--i) * .05s); }
  .hint .fl span:nth-child(3n+1) { color: #3e4f9c; } .hint .fl span:nth-child(3n+2) { color: #c25a7c; } .hint .fl span:nth-child(3n) { color: #4b8bbf; }
  @keyframes bob { 0%, 70%, 100% { transform: none; } 80% { transform: translateY(-3px); } }
  /* main.js marks the hero .off once it has scrolled away, so the breeze stops with nobody to see it */
  .hero.off .hint .fl span { animation-play-state: paused; }
  /* 24px down: once this line leaves the top, the page counts as moved (an observer watches it, so scrolling reads nothing) */
  .moved-at { position: absolute; left: 0; top: 24px; width: 1px; height: 1px; pointer-events: none; }
  .hint .swap { display: inline-block; transition: opacity .3s, filter .3s; }
  .hint .swap.out { opacity: 0; filter: blur(4px); }

  /* the waiting sprout: where the hint will be, shown only if the garden is still not built 1.2s in (a fast load never sees it).
     it stitches up cell by cell, the bud breathes, and when main.js adds .ready it opens and hands over to the hint */
  .wait { position: absolute; left: 50%; bottom: calc(var(--dock) + 60px); translate: -50% 0; display: flex; align-items: center; gap: 10px; min-height: 44px;
    font: 400 12px/1 var(--mono); color: var(--ink-2); white-space: nowrap; pointer-events: none; opacity: 0; animation: wait-in .5s var(--ease) 1.2s forwards; }
  .wait svg { width: 20px; height: 36px; flex: none; overflow: visible; shape-rendering: crispEdges; }
  .wait .w-b { display: none; }
  .wait-s rect { animation: stitch .3s linear both; animation-delay: calc(var(--k) * .32s); }
  .wait-b rect { opacity: 0; }
  .wait-bud { transform-box: fill-box; transform-origin: 50% 100%; animation: breathe 2.4s ease-in-out 3.9s infinite; }
  .wait .sp-c { transition: fill .3s; }
  @keyframes wait-in { to { opacity: 1; } }
  @keyframes wait-out { from, 55% { opacity: 1; } to { opacity: 0; } }
  @keyframes breathe { 0%, 100% { opacity: 1; transform: none; } 50% { opacity: .6; transform: scale(1.12); } }
  /* ready before it ever showed: gone. ready while it was up (.waited): the bud opens, holds a beat, then it fades as the hint comes in */
  html.ready .wait { display: none; }
  html.ready.waited .wait { display: flex; opacity: 1; animation: wait-out 1.2s ease .1s forwards; }
  html.ready .wait-bud { animation: none; }
  html.ready .wait-b rect { animation: stitch .16s linear both; animation-delay: calc(var(--k) * 40ms); }
  html.ready .wait .sp-c { fill: #9b5a14; }
  html.ready .wait .w-a { display: none; } html.ready .wait .w-b { display: inline; }
  /* the bundle never came (offline, blocked): stop pretending */
  html.late:not(.ready) .wait { display: none; }
  @media (max-width: 640px) { .wait { bottom: calc(var(--dock) + 104px); } }

  /* clear the garden: a quiet pixel button in the corner, shown once there's something to clear */
  .clear { position: absolute; left: var(--gut); bottom: max(var(--gut), env(safe-area-inset-bottom)); display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px; padding: 0 14px; margin-left: -14px; font: 500 13px/1 var(--pixel); letter-spacing: .01em; color: var(--ink-2); white-space: nowrap;
    opacity: 0; translate: 0 8px; visibility: hidden; transition: opacity .4s var(--ease), translate .5s var(--spring), visibility 0s .5s, color .2s, transform .16s var(--ease); }
  .clear.on { opacity: 1; translate: 0 0; visibility: visible; transition: opacity .4s var(--ease), translate .5s var(--spring), visibility 0s, color .2s, transform .16s var(--ease); }
  .clear svg { width: 10px; height: 24px; transform-origin: 50% 100%; shape-rendering: crispEdges; overflow: visible; transition: transform .3s var(--spring); }
  .clear:active { transform: scale(.96); }
  .clear.dig svg { animation: dig .5s steps(4) 1; }
  @keyframes dig { 0%, 100% { transform: none; } 25% { transform: translate(2px, 2px) rotate(8deg); } 50% { transform: translate(-1px, -2px) rotate(-10deg); } 75% { transform: translate(1px, 1px); } }


  @media (hover: hover) and (pointer: fine) {
    .snd:hover { color: var(--ink); background: rgba(31, 29, 27, .05); }
    .nav .me:hover::before { background: #ffcc1f; }
    .nav .me:hover .ic img { transform: rotate(-8deg) scale(1.08); }
    .nav .seg:hover { background: rgba(128, 128, 128, .14); color: var(--ink); }
    .nav [data-work]:hover .arr { transform: translateY(3px); }
    .hint:hover { color: var(--ink); }
    .clear:hover { color: var(--ink); }
    .clear:hover svg { transform: rotate(-14deg) translateY(-1px); }
  }

  /* ---- the projects live right under the garden */
  #projects { position: relative; scroll-margin-top: 0; }
  /* until work.js mounts, a sample of the section holds its place (blank, then a skeleton once skullet is up).
     the padding and sizes below mirror .wk-* in js/work/work.js so nothing moves when the real thing arrives; :where keeps them under it */
  :where(#projects) { padding: clamp(80px, 14vh, 140px) clamp(16px, 4vw, 48px) calc(clamp(56px, 9vh, 96px) + env(safe-area-inset-bottom));
    --skullet-base: rgb(0 0 0 / .06); --skullet-highlight: #fff; --skullet-radius: 4px; --skullet-animation: pulse; --skullet-speed: slow;
    --skullet-text-top: x-height; --skullet-text-bottom: baseline; }
  :root[data-theme="dark"] #projects { --skullet-base: rgb(255 255 255 / .09); --skullet-highlight: rgb(255 255 255 / .12); }
  #projects skullet-reveal { display: block; }
  skullet-reveal[loading]:not(:defined) { visibility: hidden; }
  .sk-col { max-width: 880px; margin: 0 auto; }
  .sk-open { display: grid; gap: 14px; margin-bottom: clamp(64px, 9vw, 112px); }
  .sk-label { font: 500 15px/1 var(--pixel); letter-spacing: .02em; }
  .sk-h2 { max-width: 16em; font: 500 clamp(28px, 3.2vw, 40px)/1.1 var(--display); letter-spacing: -.035em; text-wrap: balance; }
  .sk-p + .sk-p { margin-top: clamp(96px, 12vw, 152px); }
  .sk-head { display: grid; justify-items: center; text-align: center; max-width: 560px; margin: 0 auto; }
  .sk-idx { margin-bottom: 12px; font: 400 11px/1 var(--mono); letter-spacing: .04em; }
  .sk-title { font: 500 clamp(30px, 3.4vw, 40px)/1 var(--display); letter-spacing: -.035em; padding-bottom: .04em; }
  .sk-dev { font: 400 .42em/1 "Tiro Devanagari Hindi", "Kohinoor Devanagari", serif; letter-spacing: 0; vertical-align: .9em; margin-left: .1em; }
  .sk-line { margin-top: 12px; max-width: 34em; font: 400 15px/1.5 system-ui, -apple-system, "SF Pro Text", sans-serif; text-wrap: balance; }
  .sk-acts { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px 14px; margin-top: 18px; }
  .sk-read, .sk-out { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; border-radius: 99px; white-space: nowrap; }
  .sk-read { padding: 0 20px; font: 500 14px/1 system-ui, -apple-system, sans-serif; }
  .sk-out { padding: 0 16px 0 14px; font: 400 12px/1 var(--mono); }
  .sk-out i { width: 16px; height: 16px; }
  .sk-fig { margin-top: clamp(32px, 4.5vw, 56px); }
  .sk-stage { aspect-ratio: 16 / 10; border-radius: clamp(18px, 2.2vw, 28px); }
  .sk-cap { margin-top: clamp(18px, 2.4vw, 24px); font: 400 12px/1.45 var(--display); text-align: center; text-wrap: balance; }
  .sk-cap span { display: block; margin-bottom: 2px; font-weight: 500; font-size: 12.5px; }
  .sk-why { container-type: inline-size; }
  .sk-lineup { display: flex; justify-content: center; align-items: center; gap: 1.8cqw; padding: clamp(8px, 1.5vw, 16px) 0 0; }
  .sk-lineup > div { width: 14.5cqw; flex: none; } .sk-lineup > .is-main { width: 17.5cqw; }
  .sk-lineup .sk-cap span { width: fit-content; margin-inline: auto; }
  .sk-glass { aspect-ratio: 392 / 848; container-type: inline-size; }
  .sk-glass > i { display: block; height: 100%; border-radius: 12.5cqw; }
  @media (max-width: 640px) {
    :where(#projects) { padding-top: clamp(72px, 12vh, 104px); }
    .sk-title { font-size: clamp(28px, 8.5vw, 34px); }
    .sk-line { margin-top: 18px; }
    .sk-fig { margin-top: 28px; }
    .sk-vy { aspect-ratio: 1; box-sizing: content-box; padding: 26px 0; }
    .sk-why { --hw: calc((100cqw - 32px) / 4.2); }
    .sk-lineup { gap: 8px; padding: 0 0 40px; }
    .sk-lineup > div { position: relative; width: calc(var(--hw) * .8); } .sk-lineup > .is-main { width: var(--hw); }
    .sk-lineup > :nth-child(1) { order: 4; } .sk-lineup > :nth-child(2) { order: 5; } .sk-lineup > :nth-child(3) { order: 3; }
    .sk-lineup > :nth-child(4) { order: 1; } .sk-lineup > :nth-child(5) { order: 2; }
    .sk-lineup .sk-cap { position: absolute; left: 50%; top: calc(50% + var(--hw) * 424 / 392 + 19px); translate: -50% 0; margin: 0; font-size: 0; white-space: nowrap; }
    .sk-lineup .sk-cap span { margin: 0; font: 500 12px/1 var(--display); }
    .sk-cap { font-size: 11px; } .sk-cap span { font-size: 12px; }
  }
  /* night mode (data-theme="dark" on html): everything under the garden goes pitch black, not navy */
  :root[data-theme="dark"] body { background: #000; }
  :root[data-theme="dark"] .foot { color: rgba(242, 242, 240, .5); }
  @media (hover: hover) and (pointer: fine) { :root[data-theme="dark"] .foot a:hover { color: #f2f2f0; } }
  .foot { display: flex; justify-content: space-between; gap: 16px; padding: 28px var(--gut) max(22px, env(safe-area-inset-bottom));
    font: 400 10.5px/1.2 var(--mono); color: var(--ink-3); letter-spacing: .02em; }
  .foot nav { display: flex; gap: 14px; }
  .foot nav a { position: relative; } .foot nav a::before { content: ""; position: absolute; inset: -12px -6px; }
  .foot a { transition: color .2s; }
  @media (hover: hover) and (pointer: fine) { .foot a:hover { color: var(--ink); } }

  .in { opacity: 0; animation: in 1.1s var(--ease) forwards; animation-delay: var(--d, .2s); }
  @keyframes in { from { opacity: 0; translate: var(--tx, 0) 10px; filter: blur(6px); } to { opacity: 1; translate: var(--tx, 0) 0; filter: none; } }
  .mark.in, .nav.in, .hint.in { --tx: -50%; }

  @media (max-width: 640px) {
    .mark { top: 21svh; }
    .wm { width: min(84vw, 360px); }
    .cw { font-size: 10.5px; }
    .top { right: calc(var(--gut) - 10px); }
    .hint { bottom: calc(var(--dock) + 104px); font-size: 11.5px; min-height: 44px; }
    /* on a phone it sits between the hint and the dock, clear of mochi in the corner */
    .clear { left: 50%; bottom: calc(var(--dock) + 60px); margin: 0; font-size: 12.5px; translate: -50% 8px; }
    .clear.on { translate: -50% 0; }
    .foot { justify-content: center; }
    .foot > span { display: none; }
  }
  @media (max-height: 640px) and (min-width: 641px) { .mark { top: 20svh; } }
  @media (prefers-reduced-motion: reduce) {
    .in { animation: none; opacity: 1; }
    .hint .fl span { animation: none; }
    .wait { animation: wait-in 0s 1.2s forwards; }
    .wait-s rect, .wait-bud, html.ready .wait-bud { animation: none; }
    html.ready .wait-b rect { animation: none; opacity: 1; }
    html.ready.waited .wait { animation: wait-out 0s .6s forwards; }
    html.ready .hint { --d: 0s !important; animation-duration: 0s; } html.ready.waited .hint { --d: .6s !important; }
    .clear, .clear.on { translate: none; transition: opacity .2s, visibility 0s; } .clear.dig svg { animation: none; }
    @media (max-width: 640px) { .clear, .clear.on { translate: -50% 0; } }
    .load .wm-l path, .load .wm-f rect { animation: none; }
    .nav, .nav :is(.me, .seg, .more, .lb), .nav::before, .nav .me::before, .nav .me::after { transition: opacity .15s !important; }
  }

  /* ---- from the garden to the work: scrubbed by the scroll itself, off the main thread. no js, nothing to load */
  /* sits wholly below the hero, so at any screen size it stays out of the garden until you scroll */
  .seam { --c: 7px; height: calc(var(--c) * 3); margin: 0 var(--gut); position: relative; z-index: 2;
    background: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 3' shape-rendering='crispEdges'><rect x='1' y='0' width='1' height='1' fill='%23e8412f'/><rect x='0' y='1' width='1' height='1' fill='%23e8412f'/><rect x='1' y='1' width='1' height='1' fill='%23ffd04a'/><rect x='2' y='1' width='1' height='1' fill='%23e8412f'/><rect x='1' y='2' width='1' height='1' fill='%23e8412f'/><rect x='4' y='1' width='1' height='1' fill='%231f8a3a'/><rect x='7' y='0' width='1' height='1' fill='%232447d8'/><rect x='6' y='1' width='1' height='1' fill='%232447d8'/><rect x='7' y='1' width='1' height='1' fill='%23ffd04a'/><rect x='8' y='1' width='1' height='1' fill='%232447d8'/><rect x='7' y='2' width='1' height='1' fill='%232447d8'/><rect x='10' y='1' width='1' height='1' fill='%231f8a3a'/><rect x='13' y='0' width='1' height='1' fill='%23f594b8'/><rect x='12' y='1' width='1' height='1' fill='%23f594b8'/><rect x='13' y='1' width='1' height='1' fill='%23e3a21a'/><rect x='14' y='1' width='1' height='1' fill='%23f594b8'/><rect x='13' y='2' width='1' height='1' fill='%23f594b8'/><rect x='16' y='1' width='1' height='1' fill='%231f8a3a'/><rect x='19' y='0' width='1' height='1' fill='%23ffc93c'/><rect x='18' y='1' width='1' height='1' fill='%23ffc93c'/><rect x='19' y='1' width='1' height='1' fill='%23e2562b'/><rect x='20' y='1' width='1' height='1' fill='%23ffc93c'/><rect x='19' y='2' width='1' height='1' fill='%23ffc93c'/><rect x='22' y='1' width='1' height='1' fill='%231f8a3a'/></svg>") 0 0 / calc(var(--c) * 24) 100% repeat-x; image-rendering: pixelated; }
  @media (max-width: 640px) { .seam { --c: 5px; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* the playground eases back as you leave it */
      /* the hero clips its overflow, which makes it its own scroller; its children read the page's scroll through a named timeline */
      .hero { view-timeline: --hero block; }
      .hero > .ui { animation: hero-out linear both; animation-timeline: --hero; animation-range: exit 0% exit 75%; }
      #garden { animation: garden-out linear both; animation-timeline: --hero; animation-range: exit 0% exit 100%; }
      /* the border stitches itself in, a cell at a time, as you cross the seam */
      .seam { animation: seam-in steps(48, end) both; animation-timeline: view(); animation-range: entry 10% cover 45%; }
      @keyframes hero-out { to { opacity: 0; translate: 0 -6vh; scale: .97; } }
      @keyframes garden-out { to { translate: 0 14vh; opacity: .35; } }
      @keyframes seam-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
      @media (max-width: 640px) {
        @keyframes hero-out { to { opacity: 0; } }
        @keyframes garden-out { to { opacity: .4; } }
      }
    }
  }
</style>
<PageTransitions />
<Speculation />
{import.meta.env.DEV && <ProtoHead />}
<Titles />
<Analytics />
</head>
<body>
<main>
  <section class="hero" id="top" aria-label="Garden">
    <canvas id="garden" aria-hidden="true"></canvas>
    <i class="moved-at" aria-hidden="true"></i>
    <div class="ui">
      <div class="top in" style="--d:.1s">
        <div class="tr-r">
          <button class="snd" id="snd" type="button" aria-pressed="true" aria-label="Sound"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z"/><path class="w1" d="M15.5 9.2a4 4 0 0 1 0 5.6"/><path class="w2" d="M18.2 6.8a7.4 7.4 0 0 1 0 10.4"/><path class="x" d="M16 9.5l5 5M21 9.5l-5 5"/></svg></button></div>
      </div>

      <div class="mark in" style="--d:.25s">
        <span class="cw tl">Hello,</span><span class="cw tr">I’m</span>
        <h1 class="load"><span class="sr">Soumik Halder, design engineer</span><Wordmark /></h1>
        <span class="cw bl">Design</span><span class="cw br">engineer</span>
      </div>

      <div class="wait" aria-hidden="true">
        <svg viewBox="0 0 5 9"><g class="wait-s">
          <rect x="2" y="8" width="1" height="1" fill="#1f8a3a" style="--k:0"/><rect x="2" y="7" width="1" height="1" fill="#16702d" style="--k:1"/>
          <rect x="2" y="6" width="1" height="1" fill="#1f8a3a" style="--k:2"/><rect x="1" y="6" width="1" height="1" fill="#35a64b" style="--k:3"/>
          <rect x="2" y="5" width="1" height="1" fill="#16702d" style="--k:4"/><rect x="3" y="5" width="1" height="1" fill="#35a64b" style="--k:5"/>
          <rect x="0" y="5" width="1" height="1" fill="#35a64b" style="--k:6"/><rect x="2" y="4" width="1" height="1" fill="#1f8a3a" style="--k:7"/>
          <rect x="4" y="4" width="1" height="1" fill="#35a64b" style="--k:8"/><rect x="2" y="3" width="1" height="1" fill="#16702d" style="--k:9"/>
          <g class="wait-bud"><rect class="sp-c" x="2" y="2" width="1" height="1" fill="#d98a1c" style="--k:10"/><rect x="2" y="1" width="1" height="1" fill="#f5ae1f" style="--k:11"/></g>
        </g><g class="wait-b">
          <rect x="2" y="0" width="1" height="1" fill="#ffc93c" style="--k:0"/><rect x="1" y="1" width="1" height="1" fill="#ffc93c" style="--k:1"/>
          <rect x="3" y="1" width="1" height="1" fill="#ffc93c" style="--k:2"/><rect x="1" y="2" width="1" height="1" fill="#d98a1c" style="--k:3"/>
          <rect x="3" y="2" width="1" height="1" fill="#d98a1c" style="--k:4"/><rect x="0" y="2" width="1" height="1" fill="#ffc93c" style="--k:5"/>
          <rect x="4" y="2" width="1" height="1" fill="#ffc93c" style="--k:6"/>
        </g></svg>
        <span class="w-a">planting the garden…</span><span class="w-b">there it is.</span>
      </div>
      <button class="hint" id="hint"><span class="swap"><span class="fl">click anywhere to grow a flower</span></span></button>
      <button class="clear" id="clear" type="button" aria-label="Clear the garden" tabindex="-1"><svg viewBox="0 0 5 12" aria-hidden="true"><path fill="#6e3f12" d="M1 0h1v1h-1zM2 0h1v1h-1zM3 0h1v1h-1zM1 1h1v1h-1zM3 1h1v1h-1z"/><path fill="#b8742a" d="M2 2h1v1h-1zM2 3h1v1h-1zM2 4h1v1h-1zM2 5h1v1h-1z"/><path fill="#3d4249" d="M1 6h1v1h-1zM3 6h1v1h-1zM0 7h1v1h-1zM4 7h1v1h-1zM0 8h1v1h-1zM4 8h1v1h-1zM0 9h1v1h-1zM4 9h1v1h-1zM1 10h1v1h-1zM3 10h1v1h-1zM2 11h1v1h-1z"/><path fill="#6b7280" d="M2 6h1v1h-1z"/><path fill="#e3e8ef" d="M1 7h1v1h-1zM2 7h1v1h-1zM3 7h1v1h-1zM1 8h1v1h-1zM1 9h1v1h-1z"/><path fill="#a7b0bd" d="M2 8h1v1h-1zM3 8h1v1h-1zM2 9h1v1h-1zM3 9h1v1h-1zM2 10h1v1h-1z"/></svg>clear garden</button>
    </div>
  </section>
  <div class="seam" aria-hidden="true"></div>

  <section id="projects" aria-label="Projects" data-cases={cases.join(' ') || undefined}>
    {/* the section's shape, with its real copy, for skullet to trace while work.js is on its way (work.js swaps in the real thing) */}
    <skullet-reveal id="projects-sk" loading label="loading projects"><div class="sk-col">
      <div class="sk-open"><p class="sk-label">projects</p><p class="sk-h2">Things I designed, then built.</p></div>
      <div class="sk-p">
        <div class="sk-head"><p class="sk-idx">01 / 03 · live store</p><p class="sk-title">WhyClub</p>
          <p class="sk-line">A streetwear label from India that sells oversized graphic tees in small drops. The name came from its founder. Everything else is mine: the design, the graphics, the store and the backend.</p>
          <p class="sk-acts">{cases.includes('whyclub') && <span class="sk-read" skullet-block>Read the case study <span>→</span></span>}<span class="sk-out" skullet-block><i></i>WhyClub <span>↗</span></span></p></div>
        <div class="sk-fig sk-why"><div class="sk-lineup">
          {[['Shop', 'Two to a row. The + is quick add.'], ['Quick add', 'Size and price, without leaving.'], ['Home', 'One drop per screen. Swipe for the next.'], ['Product', 'Details rise over the photo.'], ['Bag', 'Each piece on one line, then checkout.']].map(([name, does], i) =>
            <div class={i === 2 ? 'is-main' : undefined}><div class="sk-glass"><i skullet-block></i></div><p class="sk-cap"><span>{name}</span>{does}</p></div>)}
        </div></div>
      </div>
      <div class="sk-p">
        <div class="sk-head"><p class="sk-idx">02 / 03 · concept, FigBuild 2026</p><p class="sk-title">Vayu <span class="sk-dev" lang="hi">वायु</span></p>
          <p class="sk-line">A watch that taps your wrist when the air around you turns bad, and hands you a cleaner way through in the same moment. Like Apple Watch’s noise alerts, but for the air. Designed with Shardul N.</p>
          <p class="sk-acts">{cases.includes('vayu') && <span class="sk-read" skullet-block>See the concept <span>→</span></span>}<span class="sk-out" skullet-block><i></i>Devpost <span>↗</span></span></p></div>
        <div class="sk-fig"><div class="sk-stage sk-vy" skullet-block></div><p class="sk-cap"><span>Not the shortest route. The one with the cleanest air.</span>The phone app and the watch I redesigned after the film we made for FigBuild.</p></div>
      </div>
      <div class="sk-p">
        <div class="sk-head"><p class="sk-idx">03 / 03 · macOS app, open source</p><p class="sk-title">Font Preview</p>
          <p class="sk-line">Quick Look for fonts on macOS. Select a font file in Finder, press Space, and see the whole font without installing it, WOFF2 included. I kept running into this myself, so I built it.</p>
          <p class="sk-acts">{cases.includes('font-preview') && <span class="sk-read" skullet-block>Try it here <span>→</span></span>}<span class="sk-out" skullet-block><i></i>GitHub <span>↗</span></span></p></div>
        <div class="sk-fig"><div class="sk-stage" skullet-block></div><p class="sk-cap"><span>Press Space on a font file.</span>The family set in itself, every size, then every glyph. Day or night, from a switch in the corner.</p></div>
      </div>
    </div></skullet-reveal>
    <noscript>
    <h2>Soumik Halder, design engineer</h2>
    <p>I design and build interfaces end to end: the brand, the motion, the WebGL, and the code that ships it.</p>
    <h3><a href="https://whyclub.in">WhyClub</a></h3>
    <p>A streetwear label from India that sells oversized graphic tees in small drops. The name came from its founder. Everything else is mine: the design, the graphics, the store and the backend.{cases.includes('whyclub') && <> <a href="/projects/whyclub/">Read the case study</a>.</>}</p>
    <h3><a href="https://devpost.com/software/vayu-ro0jfd">Vayu</a></h3>
    <p>A concept for FigBuild 2026, designed with Shardul N: a watch that taps your wrist when the air turns bad and shows you a cleaner way through.{cases.includes('vayu') && <> <a href="/projects/vayu/">See the concept</a>.</>}</p>
    <h3><a href="https://github.com/emSoumik/font-preview">Font Preview</a></h3>
    <p>A free, open-source Quick Look extension for macOS. Press Space on a font file in Finder and see the whole font, WOFF2 included, without installing it.</p>
    <p><a href="mailto:soumikhalder026@gmail.com">soumikhalder026@gmail.com</a> · <a href="https://www.linkedin.com/in/soumik7/">LinkedIn</a> · <a href="https://x.com/soumikkhalder">X</a></p>
  </noscript></section>
</main>

<!-- the dock stays on screen all the way down, so it lives outside the hero (whose ui fades out on scroll) -->
<nav class="nav in" style="--d:.9s" aria-label="Main">
  <button class="me" data-about><span class="ic"><picture><source srcset="/assets/brand/avatar.avif" type="image/avif"><img src="/assets/brand/avatar.webp" alt="" width="28" height="28" decoding="async"></picture></span><span class="lb">about me</span></button>
  <span class="more">
    <a class="seg" href="#projects" data-work>projects<span class="arr" aria-hidden="true">↓</span></a>
    <a class="seg" href="/vault/">vault</a>
    <a class="seg" href="/blog/">blog</a>
  </span>
</nav>

<footer class="foot">
  <span>© 2026 Soumik Halder</span>
  <nav aria-label="Socials" id="socials"></nav>
  <span>flowers stitched in pixels</span>
</footer>

<script is:inline>
// before the bundle is up: remember plain taps on the garden (main.js plants them once it's ready), and give up the loader if it never comes
(function () {
  var w = window, root = document.documentElement, c = document.getElementById('garden'), early = w.__early = [], d = null;
  c.addEventListener('pointerdown', function (e) {
    if (root.classList.contains('ready') || !e.isPrimary || e.button !== 0) { d = null; return; }
    d = { id: e.pointerId, x: e.clientX, y: e.clientY, t: e.pointerType };
  });
  c.addEventListener('pointerup', function (e) {
    if (!d || d.id !== e.pointerId || root.classList.contains('ready')) return;
    var r = c.getBoundingClientRect();
    if (Math.hypot(e.clientX - d.x, e.clientY - d.y) < 12 && early.length < 6) early.push([e.clientX - r.left, e.clientY - r.top, d.t]);
    d = null;
  });
  c.addEventListener('pointercancel', function () { d = null; });
  setTimeout(function () { root.classList.add('late'); }, 20000);
})();
</script>
<script src="../../js/main.js"></script>
</body>
</html>
