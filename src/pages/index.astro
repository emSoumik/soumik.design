<link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16.png">
<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Pixelify+Sans:wght@500..600&display=swap" rel="stylesheet">
<style is:inline>
  @font-face { font-family: "Faculty Glyphic"; src: url(/assets/fonts/faculty-glyphic.woff2) format("woff2"); font-display: swap; }
  :root {
    --paper: #ffffff; --ink: #1f1d1b; --ink-2: rgba(31, 29, 27, .56); --ink-3: rgba(31, 29, 27, .46); --line: rgba(31, 29, 27, .12);
    --ease: cubic-bezier(.23, 1, .32, 1); --spring: cubic-bezier(.3, 1.4, .5, 1);
    --display: "Instrument Sans", -apple-system, system-ui, sans-serif;
    --mono: ui-monospace, "SF Mono", Menlo, monospace; --ui: -apple-system, system-ui, sans-serif;
    --pixel: "Pixelify Sans", ui-monospace, "SF Mono", Menlo, monospace;
    --gut: clamp(16px, 2.6vw, 36px);
  }
  * { box-sizing: border-box; margin: 0; }
  [hidden] { display: none !important; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { background: var(--paper); color: var(--ink); font: 400 13px/1.45 var(--ui); overflow-x: hidden; overflow-x: clip;
    -webkit-font-smoothing: antialiased; -webkit-tap-highlight-color: transparent; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  ::selection { background: #d9def2; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :focus-visible { outline: 1.5px solid currentColor; outline-offset: 4px; border-radius: 6px; }

  /* ---- hero: one screen, the garden, the name, two links */
  .hero { position: relative; height: 100svh; min-height: 560px; overflow: hidden; }
  /* js swaps in pixel cursors for a mouse (a hand over a flower, a needle over soil) */
  #garden { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: pointer; touch-action: manipulation;
    -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
  /* the UI floats over the garden; only real controls take the pointer, so every empty spot plants */
  .ui { position: absolute; inset: 0; pointer-events: none; z-index: 10; }
  .ui a, .ui button { pointer-events: auto; }

  .top { position: absolute; left: var(--gut); right: var(--gut); top: max(var(--gut), env(safe-area-inset-top)); display: flex; justify-content: space-between; align-items: center; }
  /* the name in the corner opens About; padded into a pill so it's easy to hit, outset by the same amount so nothing moves */
  .me { position: relative; display: flex; align-items: center; gap: 10px; font: 500 12px/1.2 var(--mono); padding: 6px 16px 6px 6px; margin: -6px -16px -6px -6px; border-radius: 99px;
    transition: background-color .2s var(--ease), box-shadow .2s var(--ease), transform .16s var(--ease); }
  .me::before { content: ""; position: absolute; inset: -6px; }
  .me:active { transform: scale(.96); }
  .me small { display: grid; } .me small > span { grid-area: 1 / 1; transition: opacity .2s var(--ease), translate .25s var(--ease); }
  .me .me-a { opacity: 0; translate: 0 4px; color: var(--ink); }
  .me picture, .nav .ic picture { display: contents; }
  .me img { width: 40px; height: 40px; object-fit: contain; mix-blend-mode: multiply; transition: transform .5s var(--spring); }
  .me small { color: var(--ink-2); font-size: 11px; }
  .icons { display: flex; gap: 4px; }
  .icons a { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 10px; color: var(--ink-2); transition: color .2s, background .2s, transform .16s var(--ease); }
  .icons a:active { transform: scale(.96); }
  .icons a { position: relative; } .icons a::before { content: ""; position: absolute; inset: -6px -2px; }
  .icons svg { width: 16px; height: 16px; }
  .tr-r { display: flex; align-items: center; gap: 4px; }
  .snd { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 10px; color: var(--ink-2); transition: color .2s, background .2s, transform .16s var(--ease); position: relative; }
  .snd::before { content: ""; position: absolute; inset: -6px; }
  .snd:active { transform: scale(.96); }
  .snd svg { width: 17px; height: 17px; } .snd .x { display: none; }
  .snd[aria-pressed=false] .w1, .snd[aria-pressed=false] .w2 { display: none; } .snd[aria-pressed=false] .x { display: inline; }

  .mark { position: absolute; left: 50%; top: 25svh; translate: -50% 0; }
  /* the wordmark: Instrument Serif italic, with a pixel flower standing in for the i (baked to SVG) */
  .mark h1 { margin: 0; line-height: 0; }
  .wm { width: clamp(320px, 40vw, 600px); height: auto; display: block; overflow: visible; }
  .wm-f rect { shape-rendering: crispEdges; }
  .load .wm-l path { animation: ink 1s var(--ease) both; animation-delay: calc(.3s + var(--i) * 80ms); }
  .load .wm-f rect { animation: stitch .16s linear both; animation-delay: calc(1.05s + var(--k) * 42ms); }
  @keyframes ink { from { opacity: 0; transform: translateY(24px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes stitch { 0% { opacity: 0; } .1% { opacity: 1; fill: #fff3c2; } 50% { fill: #fff3c2; } 100% { opacity: 1; } }
  .wm-l path { transform-box: fill-box; }
  /* small words at the corners of the big one */
  .cw { position: absolute; font: 500 clamp(11px, .95vw, 13px)/1 var(--display); letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
  .cw.tl { left: 6%; top: -2.6em; } .cw.tr { right: 2%; top: -2.6em; } .cw.bl { left: 0; bottom: -2.6em; } .cw.br { right: 0; bottom: -2.6em; }

  /* the two main links are chunky pixel buttons, drawn like the garden: notched corners, a hard drop shadow */
  .nav { position: absolute; left: 50%; top: 76svh; translate: -50% 0; display: flex; gap: clamp(22px, 3vw, 40px); align-items: center; font: 500 16px/1 var(--pixel); letter-spacing: .01em; }
  .nav button { --b: 3px; position: relative; white-space: nowrap; display: inline-flex; align-items: center; gap: 10px; padding: 11px 16px; min-height: 46px; background: #fff; border-radius: 0;
    box-shadow: 0 calc(var(--b) * -1) 0 0 var(--ink), 0 var(--b) 0 0 var(--ink), calc(var(--b) * -1) 0 0 0 var(--ink), var(--b) 0 0 0 var(--ink), 0 calc(var(--b) * 2.4) 0 0 rgba(31, 29, 27, .16);
    transition: background-color .2s var(--ease), transform .16s var(--ease), box-shadow .16s var(--ease); }
  .nav button:active { transform: translateY(3px); box-shadow: 0 calc(var(--b) * -1) 0 0 var(--ink), 0 var(--b) 0 0 var(--ink), calc(var(--b) * -1) 0 0 0 var(--ink), var(--b) 0 0 0 var(--ink); }
  .nav button[data-about] { background: #ffd84d; }
  .nav .arr { display: inline-block; transition: transform .4s var(--spring); }
  .nav .ic { width: 26px; height: 26px; display: grid; place-items: center; }
  .nav .ic img { width: 26px; height: 26px; object-fit: contain; mix-blend-mode: multiply; }
  .nav .ic svg { width: 30px; height: auto; overflow: visible; }
  .nav .ic .px-cat { width: 27px; height: 23px; mix-blend-mode: normal; }

  .hint { position: absolute; left: 50%; top: calc(76svh + 64px); translate: -50% 0; font: 400 12px/1 var(--mono); color: var(--ink-2); white-space: nowrap;
    padding: 8px 12px; border-radius: 99px; transition: color .2s, transform .16s var(--ease); }
  .hint:active { transform: scale(.97); }
  /* the whole line bobs letter by letter in the garden's colours, like a breeze running along it */
  .hint .fl span { display: inline-block; animation: bob 2.8s var(--ease) infinite; animation-delay: calc(var(--i) * .05s); }
  .hint .fl span:nth-child(3n+1) { color: #3e4f9c; } .hint .fl span:nth-child(3n+2) { color: #c25a7c; } .hint .fl span:nth-child(3n) { color: #4b8bbf; }
  @keyframes bob { 0%, 70%, 100% { transform: none; } 80% { transform: translateY(-3px); } }
  .hint .swap { display: inline-block; transition: opacity .3s, filter .3s; }
  .hint .swap.out { opacity: 0; filter: blur(4px); }

  /* clear the garden: a quiet pixel button in the corner, shown once there's something to clear */
  .clear { position: absolute; left: var(--gut); bottom: max(var(--gut), env(safe-area-inset-bottom)); display: inline-flex; align-items: center; gap: 8px;
    min-height: 44px; padding: 0 14px; margin-left: -14px; font: 500 13px/1 var(--pixel); letter-spacing: .01em; color: var(--ink-2); white-space: nowrap;
    opacity: 0; translate: 0 8px; visibility: hidden; transition: opacity .4s var(--ease), translate .5s var(--spring), visibility 0s .5s, color .2s, transform .16s var(--ease); }
  .clear.on { opacity: 1; translate: 0 0; visibility: visible; transition: opacity .4s var(--ease), translate .5s var(--spring), visibility 0s, color .2s, transform .16s var(--ease); }
  .clear svg { width: 10px; height: 24px; transform-origin: 50% 100%; shape-rendering: crispEdges; overflow: visible; transition: transform .3s var(--spring); }
  .clear:active { transform: scale(.96); }
  .clear.dig svg { animation: dig .5s steps(4) 1; }
  @keyframes dig { 0%, 100% { transform: none; } 25% { transform: translate(2px, 2px) rotate(8deg); } 50% { transform: translate(-1px, -2px) rotate(-10deg); } 75% { transform: translate(1px, 1px); } }


  @media (hover: hover) and (pointer: fine) {
    .me:hover { background: rgba(255, 255, 255, .7); box-shadow: 0 0 0 1px var(--line); }
    .me:hover img { transform: rotate(-8deg) scale(1.08); }
    .me:hover .me-r { opacity: 0; translate: 0 -4px; } .me:hover .me-a { opacity: 1; translate: 0 0; }
    .icons a:hover, .snd:hover { color: var(--ink); background: rgba(31, 29, 27, .05); }
    .nav button:hover { background: #fff3c2; transform: translateY(-2px); }
    .nav button[data-about]:hover { background: #ffe680; }
    .nav button:hover .arr.r { transform: translateX(4px); }
    .nav button:hover .arr.d { transform: translateY(3px); }
    .hint:hover { color: var(--ink); }
    .clear:hover { color: var(--ink); }
    .clear:hover svg { transform: rotate(-14deg) translateY(-1px); }
  }

  /* ---- the work lives right under the garden */
  #work { position: relative; scroll-margin-top: 0; }
  .foot { display: flex; justify-content: space-between; gap: 16px; padding: 28px var(--gut) max(22px, env(safe-area-inset-bottom));
    font: 400 10.5px/1.2 var(--mono); color: var(--ink-3); letter-spacing: .02em; }
  .foot nav { display: flex; gap: 14px; }
  .foot nav a { position: relative; } .foot nav a::before { content: ""; position: absolute; inset: -12px -6px; }
  .foot a { transition: color .2s; }
  @media (hover: hover) and (pointer: fine) { .foot a:hover { color: var(--ink); } }

  .in { opacity: 0; animation: in 1.1s var(--ease) forwards; animation-delay: var(--d, .2s); }
  @keyframes in { from { opacity: 0; translate: var(--tx, 0) 10px; filter: blur(6px); } to { opacity: 1; translate: var(--tx, 0) 0; filter: none; } }
  .mark.in, .nav.in, .hint.in { --tx: -50%; }

  @media (max-width: 640px) {
    .icons { display: none; }
    .mark { top: 21svh; }
    .wm { width: min(84vw, 360px); }
    .cw { font-size: 10.5px; }
    .nav { top: 69svh; gap: 16px; font-size: 14.5px; }
    .nav button { --b: 2.5px; padding: 0 12px; min-height: 44px; gap: 7px; }
    .nav .ic, .nav .ic img { width: 20px; height: 20px; }
    .nav .ic svg { width: 24px; }
    .hint { top: calc(69svh + 58px); font-size: 11.5px; min-height: 44px; }
    /* on a phone it sits under the hint, clear of mochi in the corner */
    .clear { left: 50%; bottom: auto; top: calc(69svh + 104px); margin: 0; font-size: 12.5px; translate: -50% 8px; }
    .clear.on { translate: -50% 0; }
    .foot { justify-content: center; }
    .foot > span { display: none; }
  }
  @media (max-height: 640px) and (min-width: 641px) { .mark { top: 20svh; } .nav { top: 78svh; } .hint { top: calc(78svh + 58px); } }
  @media (prefers-reduced-motion: reduce) {
    .in { animation: none; opacity: 1; }
    .hint .fl span { animation: none; }
    .clear, .clear.on { translate: none; transition: opacity .2s, visibility 0s; } .clear.dig svg { animation: none; }
    @media (max-width: 640px) { .clear, .clear.on { translate: -50% 0; } }
    .load .wm-l path, .load .wm-f rect { animation: none; }
  }

  /* ---- from the garden to the work: scrubbed by the scroll itself, off the main thread. no js, nothing to load */
  /* sits wholly below the hero, so at any screen size it stays out of the garden until you scroll */
  .seam { --c: 7px; height: calc(var(--c) * 3); margin: 0 var(--gut); position: relative; z-index: 2;
    background: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 3' shape-rendering='crispEdges'><rect x='1' y='0' width='1' height='1' fill='%23e8412f'/><rect x='0' y='1' width='1' height='1' fill='%23e8412f'/><rect x='1' y='1' width='1' height='1' fill='%23ffd04a'/><rect x='2' y='1' width='1' height='1' fill='%23e8412f'/><rect x='1' y='2' width='1' height='1' fill='%23e8412f'/><rect x='4' y='1' width='1' height='1' fill='%231f8a3a'/><rect x='7' y='0' width='1' height='1' fill='%232447d8'/><rect x='6' y='1' width='1' height='1' fill='%232447d8'/><rect x='7' y='1' width='1' height='1' fill='%23ffd04a'/><rect x='8' y='1' width='1' height='1' fill='%232447d8'/><rect x='7' y='2' width='1' height='1' fill='%232447d8'/><rect x='10' y='1' width='1' height='1' fill='%231f8a3a'/><rect x='13' y='0' width='1' height='1' fill='%23f594b8'/><rect x='12' y='1' width='1' height='1' fill='%23f594b8'/><rect x='13' y='1' width='1' height='1' fill='%23e3a21a'/><rect x='14' y='1' width='1' height='1' fill='%23f594b8'/><rect x='13' y='2' width='1' height='1' fill='%23f594b8'/><rect x='16' y='1' width='1' height='1' fill='%231f8a3a'/><rect x='19' y='0' width='1' height='1' fill='%23ffc93c'/><rect x='18' y='1' width='1' height='1' fill='%23ffc93c'/><rect x='19' y='1' width='1' height='1' fill='%23e2562b'/><rect x='20' y='1' width='1' height='1' fill='%23ffc93c'/><rect x='19' y='2' width='1' height='1' fill='%23ffc93c'/><rect x='22' y='1' width='1' height='1' fill='%231f8a3a'/></svg>") 0 0 / calc(var(--c) * 24) 100% repeat-x; image-rendering: pixelated; }
  @media (max-width: 640px) { .seam { --c: 5px; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* the playground eases back as you leave it */
      /* the hero clips its overflow, which makes it its own scroller; its children read the page's scroll through a named timeline */
      .hero { view-timeline: --hero block; }
      .hero > .ui { animation: hero-out linear both; animation-timeline: --hero; animation-range: exit 0% exit 75%; }
      #garden { animation: garden-out linear both; animation-timeline: --hero; animation-range: exit 0% exit 100%; }
      /* the border stitches itself in, a cell at a time, as you cross the seam */
      .seam { animation: seam-in steps(48, end) both; animation-timeline: view(); animation-range: entry 10% cover 45%; }
      @keyframes hero-out { to { opacity: 0; translate: 0 -6vh; scale: .97; } }
      @keyframes garden-out { to { translate: 0 14vh; opacity: .35; } }
      @keyframes seam-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
      @media (max-width: 640px) {
        @keyframes hero-out { to { opacity: 0; } }
        @keyframes garden-out { to { opacity: .4; } }
      }
    }
  }
</style>
</head>
<body>
<main>
  <section class="hero" id="top" aria-label="Garden">
    <canvas id="garden" aria-hidden="true"></canvas>
    <div class="ui">
      <div class="top in" style="--d:.1s">
        <a class="me" href="#about" data-about aria-label="Soumik, design engineer. About me">
          <picture><source srcset="/assets/brand/avatar.avif" type="image/avif"><img src="/assets/brand/avatar.webp" alt="" width="40" height="40"></picture>
          <span>soumik<small><span class="me-r">design engineer</span><span class="me-a" aria-hidden="true">about me →</span></small></span>
        </a>
        <div class="tr-r"><nav class="icons" aria-label="Elsewhere" id="icons"></nav>
          <button class="snd" id="snd" type="button" aria-pressed="true" aria-label="Sound"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z"/><path class="w1" d="M15.5 9.2a4 4 0 0 1 0 5.6"/><path class="w2" d="M18.2 6.8a7.4 7.4 0 0 1 0 10.4"/><path class="x" d="M16 9.5l5 5M21 9.5l-5 5"/></svg></button></div>
      </div>

      <div class="mark in" style="--d:.25s">
        <span class="cw tl">Hello,</span><span class="cw tr">I’m</span>
        <h1 class="load"><span class="sr">Soumik Halder, design engineer</span><Wordmark /></h1>
        <span class="cw bl">Design</span><span class="cw br">engineer</span>
      </div>

      <nav class="nav in" style="--d:.9s" aria-label="Main">
        <button data-about><span class="ic"><picture><source srcset="/assets/brand/avatar.avif" type="image/avif"><img src="/assets/brand/avatar.webp" alt="" width="26" height="26"></picture></span><span class="arr r">→</span> About me</button>
        <button data-work>My work <span class="arr d">↓</span><span class="ic"><picture><source srcset="/assets/mochi/icon.avif" type="image/avif"><img class="px-cat" src="/assets/mochi/icon.webp" alt="" width="27" height="23"></picture></span></button>
