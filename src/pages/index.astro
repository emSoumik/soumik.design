---
import Wordmark from '../components/Wordmark.astro';
import { published } from '../lib/content';

// the work section links a project to its case study only once that case study is published (a draft would 404 on soumik.design)
const cases = (await published('work')).map((e) => e.id);
---
<!doctype html>
<html lang="en">
<head>
