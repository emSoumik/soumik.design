---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostHeader from '../../components/blog/PostHeader.astro';
import Title from '../../components/blog/Title.astro';
import { REFS } from '../../components/blog/refs';
import { components } from '../../components/mdx';
import { published, day, iso } from '../../lib/content';

export async function getStaticPaths() {
  const all = await published('blog');
  // newest first, so the one before a post in the list is the next one written
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, newer: all[i - 1], older: all[i + 1] } }));
}
const { entry, newer, older } = Astro.props;
const { data } = entry;
// <Ref> numbers itself from this list while the post renders
(Astro.locals as { refs?: string[] }).refs = data.refs;
const { Content } = await render(entry);
// link previews want a png: some scrapers won't show webp or avif
const cover = data.cover && await getImage({ src: data.cover, format: 'png', width: 1200 });
const card = cover && { src: cover.src, width: cover.attributes.width as number, height: cover.attributes.height as number, alt: data.coverAlt ?? '' };
// about 230 words a minute, code and components included, rounded up
const minutes = Math.max(1, Math.ceil((entry.body ?? '').split(/\s+/).length / 230));
const refs = data.refs.filter((id) => REFS[id]);
---
<Base title={data.title} description={data.description} type="article" published={data.date} image={card || undefined} back={{ href: '/blog/', label: 'the blog' }}>
  <script is:inline>document.documentElement.classList.add('js')</script>
  <article class="blog bp">
    <div class="bp-progress" aria-hidden="true"></div>
    <header class="bp-head">
      <p class="bp-meta">
        <a href="/blog/">blog</a>
        <time datetime={iso(data.date)}>{day(data.date).toLowerCase()}</time>
        <span>{minutes} min read</span>
        {data.draft && <span class="draft">draft</span>}
      </p>
      <h1 class="bp-title"><Title text={data.title} accent={data.accent} /></h1>
      <p class="bp-lede">{data.description}</p>
    </header>
    {data.cover
      ? <div class="cover"><Picture src={data.cover} alt={data.coverAlt ?? ''} widths={[720, data.cover.width]} sizes="(min-width: 1140px) 1080px, calc(100vw - 32px)" formats={['avif']} fallbackFormat="webp" loading="eager" /></div>
      : <PostHeader kind={data.header ?? 'garden'} slug={entry.id} />}
    <div class="prose">
      <Content components={components} />
    </div>
    <footer class="bp-end">
      {refs.length > 0 && (
        <section aria-labelledby="refs-h">
          <h2 id="refs-h">references</h2>
          <ol class="bp-refs">
            {refs.map((id, i) => {
              const r = REFS[id];
              return (
                <li id={`ref-${i + 1}`}>
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    {r.href ? <a href={r.href} target="_blank" rel="noopener">{r.title}</a> : <code>{r.title}</code>}, {r.site}. {r.note}
                    {r.href && <small>{r.href.replace(/^https:\/\//, '')}</small>}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      )}
      {(newer || older) && (
        <nav class="bp-near" aria-label="More posts">
          {older && <a class="prev" href={`/blog/${older.id}/`}><span>← older</span><strong>{older.data.title}</strong></a>}
          {newer && <a class="next" href={`/blog/${newer.id}/`}><span>newer →</span><strong>{newer.data.title}</strong></a>}
        </nav>
      )}
    </footer>
  </article>
</Base>
