---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { components } from '../../components/mdx';
import { published, day, iso } from '../../lib/content';

export async function getStaticPaths() {
  return (await published('blog')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---
<Base title={data.title} description={data.description} type="article" published={data.date} image={data.cover?.src}>
  <article>
    <header class="article-head">
      <p class="eyebrow"><a href="/blog/">blog</a><span aria-hidden="true">·</span><time datetime={iso(data.date)}>{day(data.date)}</time>{data.draft && <span class="draft">draft</span>}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
    </header>
    {data.cover && <div class="cover"><Picture src={data.cover} alt={data.coverAlt ?? ''} widths={[720, data.cover.width]} sizes="(min-width: 1140px) 1080px, calc(100vw - 32px)" formats={['avif']} fallbackFormat="webp" loading="eager" /></div>}
    <div class="prose">
      <Content components={components} />
    </div>
  </article>
</Base>
