---
// LAB: a rebuild of how the store tints safari from the hero photo, using the store's own maths
// (why-club src/lib/hero-logo-tone.ts: sample the top 16px of the photo on a 48×12 canvas, average it, then
// chromeTint mixes it 65/35 with its own luma and darkens it a touch). like the store it waits 160ms after a
// swipe settles before it repaints, and reads each photo once
import { A } from './lab';
const photos = [
  ['hero-star', 'Please, I’m a Star, against a weathered wall'],
  ['hero-cupid', 'Cupid’s Last Shot, on a lawn'],
  ['hero-inner', 'Inner Child, against an orange wall'],
];
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={['tt', cls]} data-tt data-mode="after">
  <div class="phone">
    <div class="track" tabindex="0" role="group" aria-roledescription="carousel" aria-label="Hero photos. Swipe or use the arrow keys.">
      {photos.map(([src, alt], i) => (
        <picture class="slide" aria-label={`${i + 1} of ${photos.length}`}>
          <source srcset={`${A}lab/${src}.avif`} type="image/avif">
          <img src={`${A}lab/${src}.webp`} alt={alt} loading="lazy" decoding="async" draggable="false">
        </picture>
      ))}
    </div>
    <div class="status" aria-hidden="true"><span>9:41</span><i></i></div>
    <div class="fade" aria-hidden="true"></div>
    <div class="below" aria-hidden="true"></div>
    <div class="bar" aria-hidden="true"><span>whyclub.in</span></div>
  </div>

  <div class="controls">
    <div class="seg" role="radiogroup" aria-label="Browser colour">
      <button type="button" role="radio" aria-checked="false" data-mode="before">Before</button>
      <button type="button" role="radio" aria-checked="true" data-mode="after">After</button>
    </div>
    <div class="steps">
      <button type="button" class="arrow" data-step="-1" aria-label="Previous photo"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
      <button type="button" class="arrow" data-step="1" aria-label="Next photo"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
    </div>
  </div>
  <p class="read" aria-live="polite"><span class="sw edge"></span><span class="t-edge">Top edge</span><span class="arrowto" aria-hidden="true">→</span><span class="sw tint"></span><span class="t-tint">Browser</span></p>
</div>

<style>
  .tt { --tint: #fff; --tint-ink: #000; display: grid; justify-items: center; gap: 18px; }
  .phone { position: relative; width: min(300px, 100%); aspect-ratio: 9 / 19.5; border-radius: 44px; overflow: hidden; background: #fff; isolation: isolate;
    box-shadow: 0 0 0 .5px rgba(22, 20, 15, .16), 0 30px 60px -36px rgba(40, 30, 15, .45); container-type: inline-size; }
  .track { position: absolute; inset: 0; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; outline: none; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { box-shadow: inset 0 0 0 2px #fff, inset 0 0 0 4px var(--ink); border-radius: 44px; }
  .slide { flex: 0 0 100%; scroll-snap-align: center; scroll-snap-stop: always; display: block; }
  .slide img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; display: block; }
  /* the status bar takes the tint; the time flips to stay readable on it */
  .status { position: absolute; left: 0; right: 0; top: 0; height: 13.5cqw; z-index: 2; display: flex; align-items: center; justify-content: space-between;
    padding: 2.5cqw 9cqw 0; background: var(--tint); color: var(--tint-ink); font: 600 4.6cqw/1 var(--ui); }
  .status i { width: 15cqw; height: 4cqw; border-radius: 1.2cqw; background: currentColor; opacity: .9; mask: linear-gradient(90deg, #000 62%, transparent 62% 70%, #000 70%); }
  /* the short gradient from the bar's shade into the photo */
  .fade { position: absolute; left: 0; right: 0; top: 13.5cqw; height: 10cqw; z-index: 1; pointer-events: none;
    background: linear-gradient(var(--tint), transparent); transition: opacity .35s var(--ease); }
  /* before: the photo stopped short and the page's white ran under the toolbar */
  .below { position: absolute; left: 0; right: 0; bottom: 0; height: 24cqw; z-index: 1; background: #fff; opacity: 0; transition: opacity .35s var(--ease); pointer-events: none; }
  .bar { position: absolute; left: 6cqw; right: 6cqw; bottom: 5cqw; height: 12.5cqw; z-index: 2; border-radius: 99px; display: grid; place-items: center;
    background: rgba(246, 246, 248, .62); -webkit-backdrop-filter: blur(14px) saturate(1.6); backdrop-filter: blur(14px) saturate(1.6);
    box-shadow: inset 0 0 0 .5px rgba(255, 255, 255, .7), 0 2px 10px rgba(0, 0, 0, .12); font: 500 4cqw/1 var(--ui); color: #111; pointer-events: none; }
  .tt[data-mode='before'] { --tint: #fff !important; --tint-ink: #000 !important; }
  .tt[data-mode='before'] .fade { opacity: 0; }
  .tt[data-mode='before'] .below { opacity: 1; }

  .controls { display: flex; align-items: center; gap: 10px; }
  .seg { display: flex; padding: 3px; border-radius: 99px; background: rgba(31, 29, 27, .06); }
  .seg button { all: unset; box-sizing: border-box; height: 38px; padding: 0 16px; border-radius: 99px; display: grid; place-items: center; cursor: pointer;
    font: 500 13px/1 var(--display); color: var(--ink-2); -webkit-tap-highlight-color: transparent; }
  .seg button[aria-checked='true'] { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(31, 29, 27, .12), 0 0 0 .5px rgba(31, 29, 27, .08); }
  .steps { display: flex; }
  .arrow { all: unset; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; cursor: pointer; color: var(--ink-2); -webkit-tap-highlight-color: transparent; }
  .arrow svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .controls button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .controls button:active { scale: .97; }
  @media (hover: hover) and (pointer: fine) { .arrow:hover, .seg button:hover { color: var(--ink); } }
  .read { display: flex; align-items: center; gap: 8px; font: 400 12px/1 var(--mono); color: var(--ink-2); font-variant-numeric: tabular-nums; min-height: 16px; }
  .sw { width: 14px; height: 14px; border-radius: 4px; box-shadow: inset 0 0 0 .5px rgba(0, 0, 0, .15); background: #eee; }
  .arrowto { color: var(--ink-3); }
  @media (prefers-reduced-motion: reduce) { .fade, .below { transition: none; } }
</style>

<script>
  // the store's maths, from why-club src/lib/hero-logo-tone.ts
  const SAMPLE_W = 48, SAMPLE_H = 12, SETTLE_MS = 160;
  const hex = (rgb: number[]) => `#${rgb.map((c) => Math.round(Math.min(255, Math.max(0, c))).toString(16).padStart(2, '0')).join('')}`;
  const channels = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const luma = (h: string) => { const [r, g, b] = channels(h); return 0.299 * r + 0.587 * g + 0.114 * b; };
  const chromeTint = (h: string) => { const l = luma(h), k = l < 128 ? 0.85 : 0.97; return hex(channels(h).map((c) => (c * 0.65 + l * 0.35) * k)); };

  const sample = (img: HTMLImageElement, strip: DOMRect) => {
    if (!img.complete || !img.naturalWidth) return null;
    const box = img.getBoundingClientRect();
    const k = Math.max(box.width / img.naturalWidth, box.height / img.naturalHeight);
    const ox = (box.width - img.naturalWidth * k) / 2, oy = 0;
    const c = document.createElement('canvas');
    c.width = SAMPLE_W; c.height = SAMPLE_H;
    const ctx = c.getContext('2d', { willReadFrequently: true })!;
    ctx.drawImage(img, (strip.left - box.left - ox) / k, (strip.top - box.top - oy) / k, strip.width / k, strip.height / k, 0, 0, SAMPLE_W, SAMPLE_H);
    const d = ctx.getImageData(0, 0, SAMPLE_W, SAMPLE_H).data;
    const sum = [0, 0, 0]; let n = 0;
    for (let i = 0; i + 3 < d.length; i += 4) { if (!d[i + 3]) continue; sum[0] += d[i]; sum[1] += d[i + 1]; sum[2] += d[i + 2]; n++; }
    return n ? hex(sum.map((s) => s / n)) : null;
  };

  document.querySelectorAll<HTMLElement>('[data-tt]').forEach((tt) => {
    const track = tt.querySelector<HTMLElement>('.track')!;
    const imgs = [...tt.querySelectorAll<HTMLImageElement>('.slide img')];
    const read = tt.querySelector<HTMLElement>('.read')!;
    const tones = new WeakMap<HTMLImageElement, { edge: string; tint: string }>();
    let timer = 0;
    const index = () => Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
    const update = () => {
      const img = imgs[index()];
      if (!img || !track.clientWidth) return;
      let tone = tones.get(img);
      if (!tone) {
        const r = track.getBoundingClientRect();
        const edge = sample(img, new DOMRect(r.left, r.top, r.width, 16));
        if (!edge) { img.addEventListener('load', update, { once: true }); return; }
        tone = { edge, tint: chromeTint(edge) };
        tones.set(img, tone);
      }
      tt.style.setProperty('--tint', tone.tint);
      tt.style.setProperty('--tint-ink', luma(tone.tint) < 140 ? '#fff' : '#000');
      read.querySelector<HTMLElement>('.edge')!.style.background = tone.edge;
      read.querySelector<HTMLElement>('.tint')!.style.background = tt.dataset.mode === 'before' ? '#ffffff' : tone.tint;
      read.querySelector('.t-edge')!.textContent = `Top edge ${tone.edge}`;
      read.querySelector('.t-tint')!.textContent = `Browser ${tt.dataset.mode === 'before' ? '#ffffff' : tone.tint}`;
    };
    // like the store: wait for the swipe to settle, so a scroll right after it never waits on the sampling
    const settle = () => { clearTimeout(timer); timer = window.setTimeout(update, SETTLE_MS); };
    track.addEventListener('scroll', settle, { passive: true });
    // the photos load lazily; sample once the frame is on screen and the first one is in
    new IntersectionObserver((e) => { if (e.some((x) => x.isIntersecting)) { imgs.forEach((i) => (i.loading = 'eager')); settle(); } }, { rootMargin: '200px' }).observe(tt);
    imgs[0].addEventListener('load', settle);

    const go = (d: number) => {
      const n = Math.min(imgs.length - 1, Math.max(0, index() + d));
      track.scrollTo({ left: n * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    tt.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const step = t.closest<HTMLElement>('[data-step]');
      if (step) go(Number(step.dataset.step));
      const m = t.closest<HTMLElement>('.seg [data-mode]');
      if (m) {
        tt.dataset.mode = m.dataset.mode;
        tt.querySelectorAll('.seg [data-mode]').forEach((b) => b.setAttribute('aria-checked', String(b === m)));
        update();
      }
    });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); e.stopPropagation(); go(e.key === 'ArrowLeft' ? -1 : 1); }
    });
  });
</script>
