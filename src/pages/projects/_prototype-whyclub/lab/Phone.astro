---
// PROTOTYPE: the store on a phone, scripted from the real screenshots: a finger taps Shop, the + on a tee, Add to bag,
// the bag, then Home, and the lap ends where it began. quick add is the real quick-add screenshot cut in two, the
// dimmed shop fading in and the sheet rising, so nothing here is redrawn. lab.ts drives it
interface Props { class?: string; bezel?: boolean }
const { class: cls, bezel = false } = Astro.props;
const A = '/assets/work/whyclub/';
---
<div class:list={['ph', { bezel }, cls]} data-phone data-beat="home" role="img"
  aria-label="The WhyClub store on a phone: from home to the shop, quick add on a tee, then the bag.">
  <div class="scr">
    <div class="s s-shop"><img src={A + 'm-02.webp'} alt="" draggable="false"><i class="badge">1</i></div>
    <img class="qa qa-dim" src={A + 'm-04.webp'} alt="" draggable="false">
    <img class="qa qa-sheet" src={A + 'm-04.webp'} alt="" draggable="false">
    <img class="s s-cart" src={A + 'm-cart.webp'} alt="" draggable="false">
    <img class="s s-home" src={A + 'm-01.webp'} alt="" draggable="false">
    <div class="tch" aria-hidden="true"><div><i></i></div></div>
  </div>
</div>

<style>
  /* the width comes from where it stands (lab.css), so nothing here outranks it */
  .ph { container-type: inline-size; }
  .scr { position: relative; aspect-ratio: 392 / 848; border-radius: 11.5cqw; overflow: hidden; background: #fff; isolation: isolate;
    box-shadow: 0 0 0 .5px rgba(22, 20, 15, .14), 0 18px 40px -22px rgba(0, 0, 0, .32); }
  .bezel .scr { box-shadow: 0 0 0 2.6cqw #141414, 0 0 0 calc(2.6cqw + 1px) #3b3b3b, 0 30px 50px -28px rgba(0, 0, 0, .45); }
  .scr img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; user-select: none; -webkit-user-drag: none; }
  .s, .qa { position: absolute; inset: 0; }

  /* the order things stack in: shop, the quick-add sheet over it, the bag sliding over both, home on top */
  .s-shop { z-index: 1; opacity: 0; transition: opacity 0s 400ms, translate 460ms cubic-bezier(.32, .72, 0, 1); }
  .qa { z-index: 2; }
  .s-cart { z-index: 3; translate: 100% 0; box-shadow: -12px 0 32px rgba(0, 0, 0, .12); transition: translate 0s 400ms; }
  .s-home { z-index: 4; transition: opacity 260ms cubic-bezier(.23, 1, .32, 1); }
  .tch { z-index: 5; }

  [data-beat='shop'] .s-shop, [data-beat='sheet'] .s-shop, [data-beat='added'] .s-shop, [data-beat='cart'] .s-shop { opacity: 1; transition: opacity 0s, translate 460ms cubic-bezier(.32, .72, 0, 1); }
  [data-beat='cart'] .s-shop { translate: -28% 0; }
  [data-beat='home'] .s-shop { transition: opacity 0s 400ms, translate 0s 400ms; }
  [data-beat='cart'] .s-cart { translate: 0 0; transition: translate 460ms cubic-bezier(.32, .72, 0, 1); }
  .ph:not([data-beat='home']) .s-home { opacity: 0; }

  /* quick add: the dimmed shop above the sheet fades in, the sheet itself comes up from below */
  .qa-dim { clip-path: inset(0 0 77% 0); opacity: 0; transition: opacity 280ms cubic-bezier(.23, 1, .32, 1); }
  .qa-sheet { clip-path: inset(22.6% 0 0 0); translate: 0 80%; transition: translate 300ms cubic-bezier(.32, .72, 0, 1); }
  [data-beat='sheet'] .qa-dim { opacity: 1; }
  [data-beat='sheet'] .qa-sheet { translate: 0 0; transition-duration: 480ms; }

  /* the count on the bag in the dock, popping in once the tee is added */
  .badge { position: absolute; left: 52.3%; top: 92.9%; width: 4.6cqw; height: 4.6cqw; translate: -50% -50%; border-radius: 50%; background: #111; color: #fff;
    font: 600 2.9cqw/4.6cqw var(--ui); font-style: normal; text-align: center; scale: 0; transition: scale 0s 400ms; }
  [data-beat='added'] .badge, [data-beat='cart'] .badge { scale: 1; transition: scale 420ms cubic-bezier(.3, 1.6, .5, 1) 120ms; }

  /* the finger: x and y move on slightly different curves, so the path bows instead of running straight */
  .tch, .tch > div { position: absolute; inset: 0; pointer-events: none; }
  .tch { transition: transform 680ms cubic-bezier(.45, 0, .25, 1); }
  .tch > div { transition: transform 680ms cubic-bezier(.3, .1, .2, 1); }
  .tch.snap, .tch.snap > div { transition: none; }
  .tch i { position: absolute; left: 0; top: 0; width: 11cqw; height: 11cqw; margin: -5.5cqw 0 0 -5.5cqw; border-radius: 50%;
    background: rgba(40, 40, 40, .2); box-shadow: 0 0 0 1.5px rgba(255, 255, 255, .92), 0 6px 16px rgba(0, 0, 0, .18);
    opacity: 0; scale: .6; transition: opacity 220ms ease, scale 260ms cubic-bezier(.23, 1, .32, 1); }
  .tch i.in { opacity: 1; scale: 1; }
  .tch i.down { animation: wc-press 320ms cubic-bezier(.23, 1, .32, 1); }
  .tch i::after { content: ''; position: absolute; inset: 0; border-radius: 50%; box-shadow: 0 0 0 1.5px rgba(255, 255, 255, .9); opacity: 0; }
  .tch i.down::after { animation: wc-ring 460ms cubic-bezier(.23, 1, .32, 1); }
  @keyframes wc-press { 40% { scale: .78; background: rgba(40, 40, 40, .34); } }
  @keyframes wc-ring { from { opacity: 1; scale: 1; } to { opacity: 0; scale: 1.9; } }
</style>
