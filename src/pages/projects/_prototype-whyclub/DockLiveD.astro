---
// the dock, live (variant D): a spec sheet. the dock drawn larger with dimension lines on its parts, like a blueprint,
// every number measured from the running component, and a short spec list under it
import './dock-ui.css';
const shapes = [['pill', 'Pill'], ['bar', 'Bar'], ['panel', 'Panel']];
interface Props { caption?: string }
const { caption } = Astro.props;
---
<figure class="dkx dkd" data-shape="bar" data-moving="true" data-mode="tour">
  <div class="top">
    <div class="seg shapes" role="radiogroup" aria-label="Dock shape">
      {shapes.map(([k, label], i) => <button type="button" role="radio" aria-checked={String(i === 1)} tabindex={i === 1 ? 0 : -1} data-go={k}>{label}</button>)}
    </div>
    <p class="ask"><span class="say" aria-hidden="true"><i></i><span class="t-tour">Tour playing. Tap the dock to take over</span><span class="t-you">Your turn. Tap anything on the dock</span></span><button type="button" class="replay">Replay tour</button></p>
  </div>
  <div class="sheet">
    <div class="stage">
      <div class="win"></div>
      <svg class="dims" aria-hidden="true"></svg>
    </div>
    <dl class="spec"></dl>
  </div>
  <p class="sline" aria-hidden="true"></p>
  <div class="seg glass" role="radiogroup" aria-label="Glass">
    <button type="button" role="radio" aria-checked="true" tabindex="0" data-glass="light">Light glass</button>
    <button type="button" role="radio" aria-checked="false" tabindex="-1" data-glass="dark">Dark glass</button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .dkd { display: grid; justify-items: center; gap: 10px; }
  .top { display: grid; justify-items: center; gap: 4px; }
  .sheet { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 300px); gap: clamp(32px, 6cqw, 80px); align-items: end; }
  /* gutters either side hold the dimension lines; the dock is drawn a little larger than life */
  .stage { position: relative; padding: 0 64px; justify-self: center; width: min(100%, calc(470px + 128px)); min-width: 0; }
  .dims { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .dims :global(.ext) { stroke: rgba(31, 29, 27, .28); stroke-width: 1; stroke-dasharray: 2 3; fill: none; }
  .dims :global(.dl) { stroke: var(--ink); stroke-width: 1; fill: none; }
  .dims :global(text) { font: 500 11px/1 var(--mono); fill: var(--ink); font-variant-numeric: tabular-nums; paint-order: stroke; stroke: #fff; stroke-width: 4px; stroke-linejoin: round; }
  .dims, .spec { transition: opacity .2s cubic-bezier(.23, 1, .32, 1); }
  .dkd[data-moving='true'] :is(.dims, .spec) { opacity: 0; transition-duration: .1s; }

  /* the spec list: one row a part, its size in mono and what it's for */
  .spec { margin: 0 0 12px; display: grid; min-width: 0; }
  .spec :global(div) { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 12px 0; border-top: 1px solid rgba(31, 29, 27, .1); }
  .spec :global(div:last-child) { border-bottom: 1px solid rgba(31, 29, 27, .1); }
  .spec :global(dt) { font: 600 13.5px/1.4 var(--display); color: var(--ink); }
  .spec :global(dd) { margin: 0; font: 400 13px/1.5 var(--display); color: var(--ink-2); grid-column: 1 / -1; text-wrap: pretty; }
  .spec :global(dd.sz) { grid-column: 2; grid-row: 1; font: 500 12px/1.4 var(--mono); color: var(--ink); font-variant-numeric: tabular-nums; }

  /* a phone: the sheet stacks, the gutters narrow, and the spec list sits under the drawing */
  @container (max-width: 820px) {
    .sheet { grid-template-columns: 1fr; gap: 18px; }
    .stage { padding: 0 44px; width: 100%; }
    .spec { margin: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dims, .spec { transition: none; }
  }
</style>

<script>
  import { liveDock, markShape, notesFor, springName, type Report, type Rect } from './dock';
  const SVG = 'http://www.w3.org/2000/svg';
  // the dimensions drawn for each shape: a width above a part, or a height beside it. tier is how far out the line sits
  type Dim = { part: string; axis: 'w' | 'h'; side?: 'l' | 'r'; tier: number; label?: string };
  const DIMS: Record<string, Dim[]> = {
    pill: [{ part: 'pill', axis: 'w', tier: 1 }, { part: 'pill', axis: 'h', side: 'r', tier: 1 }],
    bar: [{ part: 'cell', axis: 'w', tier: 1 }, { part: 'shell', axis: 'w', tier: 2 }, { part: 'shell', axis: 'h', side: 'r', tier: 1 }],
    panel: [{ part: 'panel', axis: 'w', tier: 1 }, { part: 'header', axis: 'h', side: 'r', tier: 1 }, { part: 'tile', axis: 'h', side: 'l', tier: 1 },
      { part: 'row', axis: 'h', side: 'r', tier: 1 }, { part: 'panel', axis: 'h', side: 'r', tier: 2 }],
  };
  const T = 14; // px between tiers
  const TICK = 4;

  document.querySelectorAll<HTMLElement>('figure.dkd').forEach((dk) => {
    const stage = dk.querySelector<HTMLElement>('.stage')!;
    const win = dk.querySelector<HTMLElement>('.win')!;
    const svg = dk.querySelector<SVGSVGElement>('.dims')!;
    const spec = dk.querySelector<HTMLElement>('.spec')!;
    const sline = dk.querySelector<HTMLElement>('.sline')!;
    let shown: Report | null = null;

    const d = liveDock(dk, {
      host: win, head: 40, maxScale: 1.2,
      onSettle: (r) => { markShape(dk, r.shape); draw(r); },
      onFit: () => { if (shown && dk.dataset.moving !== 'true') draw(shown); },
      onSpring: (sp) => { sline.innerHTML = `Last move: <b>${springName(sp)}</b> · response ${sp.response.toFixed(2)} · damping ${sp.damping.toFixed(2)} · ${sp.durationMs} ms`; },
    });
    const el = (tag: string, a: Record<string, string | number>, text?: string) => {
      const e = document.createElementNS(SVG, tag);
      for (const k in a) e.setAttribute(k, String(a[k]));
      if (text) e.textContent = text;
      svg.append(e);
    };

    function draw(r: Report) {
      shown = r;
      svg.replaceChildren(); spec.replaceChildren();
      if (!r.shape) return;
      const box = (p: Rect) => { const a = d.at(p, 0, 0, stage), b = d.at(p, 1, 1, stage); return { l: a.x, t: a.y, r: b.x, b: b.y }; };
      const sh = r.parts.shell ? box(r.parts.shell) : null;
      for (const dm of DIMS[r.shape] ?? []) {
        const p = r.parts[dm.part];
        if (!p) continue;
        const b = box(p);
        if (dm.axis === 'w') {
          // above the dock's top edge, with extension lines down to the part
          const top = Math.min(b.t, sh?.t ?? b.t);
          const y = top - T * dm.tier;
          el('path', { class: 'ext', d: `M${b.l} ${b.t - 2} V${y - 3} M${b.r} ${b.t - 2} V${y - 3}` });
          el('path', { class: 'dl', d: `M${b.l} ${y} H${b.r} M${b.l} ${y - TICK} v${TICK * 2} M${b.r} ${y - TICK} v${TICK * 2}` });
          el('text', { x: (b.l + b.r) / 2, y: y - 5, 'text-anchor': 'middle' }, String(Math.round(p.w)));
        } else {
          // beside the dock, out past its edge
          const right = dm.side === 'r';
          const edge = right ? Math.max(b.r, sh?.r ?? b.r) : Math.min(b.l, sh?.l ?? b.l);
          const x = edge + (right ? T : -T) * dm.tier;
          el('path', { class: 'ext', d: `M${right ? b.r + 2 : b.l - 2} ${b.t} H${x + (right ? 3 : -3)} M${right ? b.r + 2 : b.l - 2} ${b.b} H${x + (right ? 3 : -3)}` });
          el('path', { class: 'dl', d: `M${x} ${b.t} V${b.b} M${x - TICK} ${b.t} h${TICK * 2} M${x - TICK} ${b.b} h${TICK * 2}` });
          // the label runs along the line and breaks it, as on a drawing, so it never needs room to the side
          const my = (b.t + b.b) / 2;
          el('text', { x, y: my + 4, 'text-anchor': 'middle', transform: `rotate(-90 ${x} ${my})` }, String(Math.round(p.h)));
        }
      }
      spec.replaceChildren(...notesFor(r).map((nt) => {
        const row = document.createElement('div');
        row.innerHTML = `<dt>${nt.title}</dt><dd class="sz">${nt.size}</dd><dd>${nt.text}</dd>`;
        return row;
      }));
    }
  });
</script>
