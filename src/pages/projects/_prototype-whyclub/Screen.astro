---
// PROTOTYPE: a bare phone screen, no bezel and no panel: rounded corners and a hairline shadow on the white page.
// crop = a strip from the bottom of a screen; art = a component plate (a cut from the ui on a photo), at its own aspect.
// every one opens in the viewer: its caption is the title there, desc (or the alt) the line under it
import type { Shot } from './copy';
interface Props extends Shot { crop?: boolean; class?: string; 'data-at'?: number; view?: boolean; title?: string }
const { src, alt, caption, desc, video = false, crop = false, art = false, class: cls, 'data-at': at, view = true, title } = Astro.props;
---
<figure class:list={['scr', { crop, art }, cls]} data-at={at} data-view={view ? '' : undefined} data-title={caption ?? title} data-desc={desc ?? alt}
  tabindex={view ? 0 : undefined} role={view ? 'button' : undefined} aria-label={view ? `Open ${caption ?? title ?? 'screen'} larger` : undefined}>
  <div class="glass">
    {video ? (
      <video muted loop playsinline disablepictureinpicture preload="none" poster={`${src}.webp`} aria-label={alt}>
        <source src={`${src}.v2.webm`} type="video/webm">
        <source src={`${src}.v2.mp4`} type="video/mp4">
      </video>
      <button type="button" class="play" aria-label="Play recording" hidden>▶</button>
    ) : (
      <picture>
        <source srcset={`${src}.avif`} type="image/avif">
        <img src={`${src}.webp`} alt={alt} loading="lazy" decoding="async" draggable="false">
      </picture>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .scr { container-type: inline-size; margin: 0; min-width: 0; }
  .scr[data-view] .glass { cursor: zoom-in; }
  .scr[data-view]:focus-visible { outline: none; }
  .scr[data-view]:focus-visible .glass { outline: 2px solid var(--ink); outline-offset: 3px; }
  /* with reduced motion a recording waits on its poster; this plays it on request */
  .play { all: unset; position: absolute; left: 10px; bottom: 10px; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(17, 17, 17, .72); color: #fff; font: 400 13px/1 var(--display); cursor: pointer; }
  .play:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
  .play[hidden] { display: none; }
  .glass { position: relative; aspect-ratio: 392 / 848; border-radius: 11.5cqw; overflow: hidden; background: #fff;
    box-shadow: 0 0 0 .5px rgba(22, 20, 15, .14), 0 10px 30px -16px rgba(40, 30, 15, .28); }
  .crop .glass { aspect-ratio: auto; border-radius: 7cqw; }
  .art .glass { aspect-ratio: var(--art-ratio, 8 / 7); border-radius: clamp(12px, 3cqw, 20px); box-shadow: none; }
  .glass picture { display: contents; }
  .glass img, .glass video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .art .glass img { object-position: center; }
  .crop .glass img { height: auto; }
  figcaption { margin-top: 14px; font: 400 13px/1.45 var(--display); color: var(--ink-2); text-wrap: pretty; }
  @media (max-width: 640px) { figcaption { margin-top: 10px; font-size: 12px; } }
</style>
