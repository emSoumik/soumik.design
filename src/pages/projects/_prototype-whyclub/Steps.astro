---
// PROTOTYPE: the halden "plan tomorrow at 21:30" block. one sentence with three marked words; scrolling lights them
// in turn and the plane under it swaps to that screen, with a short line below
import Screen from './Screen.astro';
const A = '/assets/work/whyclub/';
const steps = [
  { word: 'dock', title: 'The dock opening into Shop', src: A + 'p-nav', video: true, alt: 'Tapping Shop in the dock grows it into a panel with Women, Men, Sale and My collection.', line: 'Tap Shop and the dock becomes the menu.' },
  { word: 'grid', title: 'Quick add from the grid', src: A + 'p-quickadd', video: true, alt: 'Quick add on a product card opens a card with the photos, the price and the sizes; M, then Add to bag.', line: 'Pick a size from the grid. You never leave the shop.' },
  { word: 'pass', title: 'The pass, on its way', src: A + 'pass/shipped-m', alt: 'The order pass at its On its way stage.', line: 'Then watch the order move, from paid to at your door.' },
];
---
<section class="steps" style={`--n: ${steps.length}`} aria-label="From browsing to delivery">
  <div class="stage">
    <h2>Find it in the <mark data-i="0">dock</mark>, add it from the <mark data-i="1">grid</mark> and follow it on the <mark data-i="2">pass</mark>.</h2>
    <div class="plane">
      {steps.map((s, i) => (
        <div class="shot" data-i={i}>
          <Screen src={s.src} video={s.video} alt={s.alt} title={s.title} desc={s.line} class="phone" />
        </div>
      ))}
    </div>
    <div class="lines">{steps.map((s, i) => <p data-i={i}>{s.line}</p>)}</div>
  </div>
</section>

<script define:vars={{ n: steps.length }}>
  const el = document.querySelector('.steps');
  const marks = [...el.querySelectorAll('mark')], shots = [...el.querySelectorAll('.shot')], lines = [...el.querySelectorAll('.lines p')];
  let cur = -1;
  const set = (i) => {
    if (i === cur) return;
    cur = i;
    [marks, shots, lines].forEach((list) => list.forEach((n, k) => n.classList.toggle('on', k === i)));
    shots.forEach((n, k) => n.toggleAttribute('aria-hidden', k !== i));
  };
  const frame = () => {
    // hidden on phones (the opening and the chapters carry it), so there is nothing to track
    if (!el.offsetHeight) return;
    const r = el.getBoundingClientRect(), H = innerHeight;
    const p = Math.min(.999, Math.max(0, -r.top / (r.height - H)));
    set(Math.floor(p * n));
  };
  set(0);
  let raf = 0;
  addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; frame(); }); }, { passive: true });
  frame();
</script>

<style>
  .steps { height: calc(var(--n) * 50vh + 100vh); margin: clamp(48px, 8vw, 96px) auto 0; width: min(var(--wide), 100%); }
  .stage { position: sticky; top: 0; height: 100vh; height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: clamp(20px, 3vh, 32px); }
  h2 { font: 500 clamp(28px, 4.4vw, 52px)/1.14 var(--display); letter-spacing: -.03em; color: var(--ink); max-width: 17em; text-wrap: balance; }
  mark { display: inline-block; padding: 0 .16em; border-radius: .16em; line-height: 1.1; background: rgba(31, 29, 27, .06); color: var(--ink-3);
    transition: background-color .3s var(--ease), color .3s var(--ease); }
  mark.on { background: var(--ink); color: var(--paper); }
  /* the plane is a fill; the phone stands in it, cut off by its bottom edge */
  .plane { position: relative; height: clamp(260px, 42vh, 440px); border-radius: clamp(14px, 1.8vw, 20px); background: #fff; outline: 1px solid rgba(31, 29, 27, .1); outline-offset: -1px; overflow: hidden; }
  .shot { position: absolute; left: 50%; top: 8%; width: clamp(170px, 28vh, 270px); translate: -50% 24px; opacity: 0;
    transition: opacity .35s var(--ease), translate .5s var(--ease); pointer-events: none; }
  .shot.on { opacity: 1; translate: -50% 0; pointer-events: auto; }
  .shot[data-i='0'] { top: auto; bottom: 6%; }
  .plane :global(.phone .glass) { border-radius: 12.5cqw; box-shadow: 0 0 0 2.6cqw #141414, 0 0 0 calc(2.6cqw + 1px) #3b3b3b, 0 30px 50px -28px rgba(0, 0, 0, .45); }
  .lines { display: grid; }
  .lines p { grid-area: 1 / 1; max-width: 32em; font: 400 16px/1.55 var(--display); color: var(--ink-2); opacity: 0; transition: opacity .3s var(--ease); text-wrap: pretty; }
  .lines p.on { opacity: 1; }
  @media (max-width: 640px) { .steps { display: none; } }
  @media (prefers-reduced-motion: reduce) { mark, .shot, .lines p { transition: none; } .shot { translate: -50% 0; } }
</style>
