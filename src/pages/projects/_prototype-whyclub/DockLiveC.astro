---
// the dock, live (variant C): three steps you can scrub, each filling while its shape is held. the open step lists its
// notes, keyed by number to dots on the dock; on a laptop a leader runs from each note to its dot
import './dock-ui.css';
const steps = [['pill', 'Pill', 'Scrolled down'], ['bar', 'Bar', 'Top of the page'], ['panel', 'Panel', 'Shop opened']];
interface Props { caption?: string }
const { caption } = Astro.props;
---
<figure class="dkx dkc" data-shape="bar" data-moving="true" data-mode="tour">
  <div class="lay">
    <div class="rail">
      <div class="steps" role="radiogroup" aria-label="Dock shape">
        {steps.map(([k, label, sub], i) => (
          <button type="button" role="radio" class="step" aria-checked={String(i === 1)} tabindex={i === 1 ? 0 : -1} data-go={k}>
            <span class="num">0{i + 1}</span><span class="name">{label}</span><span class="sub">{sub}</span><span class="fill" aria-hidden="true"><i></i></span>
          </button>
        ))}
      </div>
      <ol class="notes" aria-live="off"></ol>
      <p class="ask"><span class="say" aria-hidden="true"><i></i><span class="t-tour">Tour playing. Tap the dock to take over</span><span class="t-you">Your turn. Tap a step, or the dock</span></span><button type="button" class="replay">Replay tour</button></p>
    </div>
    <div class="dock">
      <div class="win"></div>
      <div class="dots" aria-hidden="true"></div>
    </div>
    <div class="ctrl">
      <p class="sline" aria-hidden="true"></p>
      <div class="seg glass" role="radiogroup" aria-label="Glass">
        <button type="button" role="radio" aria-checked="true" tabindex="0" data-glass="light">Light glass</button>
        <button type="button" role="radio" aria-checked="false" tabindex="-1" data-glass="dark">Dark glass</button>
      </div>
    </div>
    <svg class="leaders" aria-hidden="true"></svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .lay { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 392px; gap: clamp(40px, 8cqw, 120px); align-items: start; }
  .rail { display: grid; gap: 20px; align-content: start; grid-row: 1 / 3; }
  .dock { position: relative; grid-column: 2; }
  .ctrl { grid-column: 2; display: grid; justify-items: center; gap: 12px; }

  /* the steps: a number, a name, and a hairline that fills while that shape is held */
  .steps { display: grid; gap: 2px; }
  .step { all: unset; box-sizing: border-box; position: relative; display: grid; grid-template-columns: 34px 1fr auto; align-items: baseline; min-height: 52px; padding: 12px 0 14px; cursor: pointer;
    -webkit-tap-highlight-color: transparent; touch-action: manipulation; user-select: none; color: var(--ink-3); transition: color .15s; }
  .step .num { font: 500 12px/1 var(--mono); }
  .step .name { font: 600 22px/1.1 var(--display); letter-spacing: -.01em; }
  .step .sub { font: 400 13px/1 var(--display); }
  .step[aria-checked='true'] { color: var(--ink); }
  .step:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 4px; }
  .fill { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; background: rgba(31, 29, 27, .12); overflow: hidden; }
  .fill i { position: absolute; inset: 0; background: var(--ink); transform-origin: 0 50%; scale: 0 1; }
  .step[aria-checked='true'] .fill i { scale: 1 1; }
  /* while the tour holds a shape, its line fills over the hold; the script restarts it each time */
  .dkc:not([data-mode='free']) .step[aria-checked='true'] .fill i { animation: fill var(--hold, 4200ms) linear both; animation-play-state: var(--run, running); }
  @keyframes fill { from { scale: 0 1; } to { scale: 1 1; } }
  @media (hover: hover) and (pointer: fine) { .step:hover { color: var(--ink); } }

  /* the open step's notes, numbered to match the dots on the dock */
  .notes { list-style: none; margin: 0; padding: 0; max-width: 360px; display: grid; gap: 14px; transition: opacity .2s cubic-bezier(.23, 1, .32, 1); }
  .notes :global(li) { display: grid; grid-template-columns: 22px 1fr; gap: 12px; font: 400 13.5px/1.5 var(--display); color: var(--ink-2); text-wrap: pretty; }
  .notes :global(li > i) { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: #fff; font: 600 12px/1 var(--display); font-style: normal; }
  .notes :global(b) { font-weight: 600; color: var(--ink); }
  .notes :global(em) { font-style: normal; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .ask { justify-items: start; }

  .dots { position: absolute; inset: 0; pointer-events: none; }
  .dots :global(i) { position: absolute; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; display: grid; place-items: center; background: var(--ink); color: #fff;
    font: 600 12px/1 var(--display); font-style: normal; box-shadow: 0 0 0 2px #fff, 0 2px 6px rgba(0, 0, 0, .2); }
  .leaders { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .leaders :global(.halo) { fill: none; stroke: #fff; stroke-width: 4; }
  .leaders :global(.ln) { fill: none; stroke: rgba(31, 29, 27, .3); stroke-width: 1; stroke-dasharray: 2 3; }
  .dots, .leaders, .notes { transition: opacity .2s cubic-bezier(.23, 1, .32, 1); }
  .dkc[data-moving='true'] :is(.dots, .leaders, .notes) { opacity: 0; transition-duration: .1s; }

  /* a phone: the steps become a row of three you can tap, the dock follows, and the notes sit under it like a sheet */
  @container (max-width: 820px) {
    .lay { grid-template-columns: 1fr; gap: 14px; }
    .rail { display: contents; }
    .steps { order: 1; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .step { grid-template-columns: 1fr; gap: 6px; min-height: 64px; padding: 8px 0 12px; }
    .step .name { font-size: 17px; }
    .step .sub { font-size: 11.5px; }
    .ask { order: 2; justify-items: center; height: 36px; }
    .rail { grid-row: auto; }
    .dock, .ctrl { grid-column: auto; }
    .dock { order: 3; }
    .ctrl { order: 5; }
    .notes { order: 4; padding-top: 14px; border-top: 1px solid rgba(31, 29, 27, .1); }
    .leaders { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dkc .step[aria-checked='true'] .fill i { animation: none; }
    .dots, .leaders, .notes { transition: none; }
  }
</style>

<script>
  import { liveDock, notesFor, springName, type Report } from './dock';
  const SVG = 'http://www.w3.org/2000/svg';
  // where each part's numbered dot sits: on an edge or an empty corner, so it never hides what it names
  const DOT: Record<string, [number, number]> = {
    pill: [.5, 0], cell: [.5, 0], shell: [.97, .03],
    header: [.5, .5], tile: [.14, .14], row: [.72, .5], panel: [.04, .02],
  };
  const HOLD = 4200;

  document.querySelectorAll<HTMLElement>('figure.dkc').forEach((dk) => {
    const lay = dk.querySelector<HTMLElement>('.lay')!;
    const box = dk.querySelector<HTMLElement>('.dock')!;
    const list = dk.querySelector<HTMLElement>('.notes')!;
    const dots = dk.querySelector<HTMLElement>('.dots')!;
    const svg = dk.querySelector<SVGSVGElement>('.leaders')!;
    const sline = dk.querySelector<HTMLElement>('.sline')!;
    const stepBtns = [...dk.querySelectorAll<HTMLElement>('.step')];
    let shown: Report | null = null;
    dk.style.setProperty('--hold', `${HOLD}ms`);

    // the step for the shape the dock is in (or heading to), with its fill restarted
    const mark = (sh: string | null) => stepBtns.forEach((b) => {
      const on = b.dataset.go === sh;
      b.setAttribute('aria-checked', String(on)); b.setAttribute('tabindex', on ? '0' : '-1');
      const i = b.querySelector<HTMLElement>('.fill i')!;
      if (on) { i.style.animation = 'none'; void i.offsetWidth; i.style.animation = ''; }
    });

    const d = liveDock(dk, {
      host: dk.querySelector<HTMLElement>('.win')!,
      dwell: HOLD,
      onSettle: (r) => { if (r.shape !== shown?.shape) mark(r.shape); draw(r); },
      onFit: () => { if (shown && dk.dataset.moving !== 'true') draw(shown); },
      onSpring: (sp) => { sline.innerHTML = `Last move: <b>${springName(sp)}</b> · response ${sp.response.toFixed(2)} · damping ${sp.damping.toFixed(2)} · ${sp.durationMs} ms`; },
    });

    function draw(r: Report) {
      shown = r;
      list.replaceChildren(); dots.replaceChildren(); svg.replaceChildren();
      if (!r.shape) return;
      const notes = notesFor(r).filter((nt) => DOT[nt.part]);
      const L = lay.getBoundingClientRect();
      const wide = getComputedStyle(svg).display !== 'none';
      notes.forEach((nt, i) => {
        const li = document.createElement('li');
        li.innerHTML = `<i>${i + 1}</i><span><b>${nt.title}</b> <em>${nt.size}</em><br>${nt.text}</span>`;
        list.append(li);
        const [fx, fy] = DOT[nt.part];
        const p = d.at(r.parts[nt.part]!, fx, fy, box);
        const dot = document.createElement('i');
        dot.textContent = String(i + 1); dot.style.left = `${p.x}px`; dot.style.top = `${p.y}px`;
        dots.append(dot);
        if (!wide) return;
        // a dotted leader from the note's number across the gap to its dot
        // starts past the end of the notes column, level with the note's title, so it never runs through text
        const nb = li.firstElementChild!.getBoundingClientRect();
        const q = d.at(r.parts[nt.part]!, fx, fy, lay);
        const sx = list.getBoundingClientRect().right - L.left + 16, sy = nb.top - L.top + nb.height / 2;
        const ex = q.x - 14, mid = (sx + ex) / 2;
        for (const cls of ['halo', 'ln']) {
          const path = document.createElementNS(SVG, 'path');
          path.setAttribute('class', cls); path.setAttribute('d', `M${sx} ${sy} C${mid} ${sy} ${mid} ${q.y} ${ex} ${q.y}`);
          svg.append(path);
        }
      });
    }
  });
</script>
