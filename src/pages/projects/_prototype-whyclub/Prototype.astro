---
// the whyclub case study, one layout (the editorial one won). [slug].astro mounts this instead of the mdx.
// the viewer opens any screen on the page
import VariantA from './VariantA.astro';
import Viewer from './Viewer.astro';
---
<VariantA />
<Viewer />

<script>
  // recordings play while on screen; with reduced motion they stay on their poster until someone presses play
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLButtonElement>('.scr .play').forEach((b) => {
      const v = b.parentElement!.querySelector('video')!;
      b.hidden = false;
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        if (v.paused) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
      });
      v.addEventListener('play', () => { b.textContent = 'Ⅱ'; b.ariaLabel = 'Pause recording'; });
      v.addEventListener('pause', () => { b.textContent = '▶'; b.ariaLabel = 'Play recording'; });
    });
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const { target, isIntersecting } of entries) {
        const v = target as HTMLVideoElement;
        if (isIntersecting && !document.hidden) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
      }
    }, { threshold: 0.35 });
    document.querySelectorAll<HTMLVideoElement>('.scr video, video.bare').forEach((v) => io.observe(v));
  }
</script>
