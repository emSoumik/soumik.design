---
// a case study written in mdx. the ones built by hand (whyclub, vayu, font-preview) have their own page files beside
// this one, so each page ships only its own css
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { components } from '../../components/mdx';
import { published } from '../../lib/content';
import { HAND_BUILT, cardOf } from './_case';

export async function getStaticPaths() {
  return (await published('work')).filter((entry) => !HAND_BUILT.includes(entry.id)).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const card = await cardOf(entry);
const domain = data.link && new URL(data.link).hostname;
---
<Base title={data.title} description={data.summary} type="article" published={data.date} image={card} back={{ href: '/#projects', label: 'projects' }}>
  <article>
    <Cover src={data.cover} alt={data.coverAlt} phones={data.coverPhones} link={data.link} />
    <header class="article-head">
      <p class="eyebrow"><a href="/projects/">{data.kind}</a><span aria-hidden="true">·</span>{data.date.getUTCFullYear()}{data.draft && <span class="draft">draft</span>}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.summary}</p>
      <dl class="facts">
        <div><dt>Role</dt><dd>{data.role}</dd></div>
        {data.tags.length > 0 && <div><dt>Work</dt><dd>{data.tags.join(', ')}</dd></div>}
        {data.link && <div><dt>{data.kind === 'concept' ? 'Link' : 'Live'}</dt><dd><a href={data.link} target="_blank" rel="noopener">{domain} <span aria-hidden="true">↗</span></a></dd></div>}
      </dl>
    </header>
    <div class="prose">
      <Content components={components} />
    </div>
  </article>
</Base>
