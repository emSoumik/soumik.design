---
// <Compare was="a sentence" now="a garden" why="…"> with <div slot="before">…</div> and <div slot="after">…</div>:
// two states of one thing behind a switch. without the script both show, side by side on a wide screen
interface Props { was: string; now: string; why?: string; label?: string; height?: number }
// (named was/now: a prop called before or after comes through empty, next to slots of those names)
const { was, now, why, label = 'before / after', height } = Astro.props;
const g = globalThis as { __cmp?: number };
const uid = `cmp-${(g.__cmp = (g.__cmp ?? 0) + 1)}`;
---
<figure class="bx cmp" data-cmp style={height ? `--cmp-h: ${height}px` : undefined}>
  <div class="cmp-top">
    <span class="px cmp-label">{label}</span>
    <div class="cmp-switch" role="tablist" aria-label={label}>
      <button type="button" role="tab" id={`${uid}-b`} aria-controls={`${uid}-pb`} aria-selected="true" tabindex="0"><span class="px">{was}</span></button>
      <button type="button" role="tab" id={`${uid}-a`} aria-controls={`${uid}-pa`} aria-selected="false" tabindex="-1"><span class="px">{now}</span></button>
      <i class="cmp-ind" aria-hidden="true"></i>
    </div>
  </div>
  <div class="cmp-panes">
    <div class="cmp-pane" role="tabpanel" id={`${uid}-pb`} aria-labelledby={`${uid}-b`} data-side="before"><span class="px cmp-tag">{was}</span><slot name="before" /></div>
    <div class="cmp-pane" role="tabpanel" id={`${uid}-pa`} aria-labelledby={`${uid}-a`} data-side="after"><span class="px cmp-tag">{now}</span><slot name="after" /></div>
  </div>
  {why && <figcaption><span class="px">why</span> {why}</figcaption>}
</figure>

<script>
  // one switch per comparison: click, or arrow keys between the two tabs
  document.querySelectorAll<HTMLElement>('[data-cmp]').forEach((fig) => {
    const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panes = [...fig.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const pick = (i: number, focus = false) => {
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(i === j)); t.tabIndex = i === j ? 0 : -1; });
      panes.forEach((p, j) => { p.toggleAttribute('data-on', i === j); p.inert = i !== j; });
      fig.dataset.side = i ? 'after' : 'before';
      if (focus) tabs[i].focus();
      fig.dispatchEvent(new CustomEvent('compare', { detail: fig.dataset.side }));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(i));
      t.addEventListener('keydown', (e) => { const to = e.key === 'ArrowRight' || e.key === 'End' ? 1 : e.key === 'ArrowLeft' || e.key === 'Home' ? 0 : -1; if (to >= 0) { e.preventDefault(); pick(to, true); } });
    });
    fig.classList.add('on');
    pick(0);
  });
</script>

<style>
  .cmp { --cmp-h: 360px; }
  .cmp-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .cmp-label { font: 500 12px/1 var(--pixel); color: var(--ink-2); }
  .cmp-switch { position: relative; display: none; grid-template-columns: 1fr 1fr; padding: 3px; border-radius: 99px; box-shadow: inset 0 0 0 1px var(--line); isolation: isolate; }
  .cmp-switch button { position: relative; z-index: 1; min-height: 38px; min-width: 104px; padding: 0 16px; border: 0; background: none; border-radius: 99px; cursor: pointer; color: var(--ink-2); font: 500 13px/1 var(--pixel); transition: color .2s var(--ease), transform .16s var(--ease); }
  /* 38px to see, 44 to hit */
  .cmp-switch button::before { content: ""; position: absolute; inset: -3px 0; }
  .cmp-switch button[aria-selected=true] { color: #fff; }
  .cmp-switch button:active { transform: scale(.97); }
  @media (hover: hover) and (pointer: fine) { .cmp-switch button[aria-selected=false]:hover { color: var(--ink); } }
  .cmp-switch button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .cmp-ind { position: absolute; z-index: 0; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px); border-radius: 99px; background: var(--ink); transition: transform .22s var(--ease); }
  .cmp[data-side=after] .cmp-ind { transform: translateX(100%); }

  .cmp-panes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cmp-pane { position: relative; min-height: var(--cmp-h); border-radius: 14px; box-shadow: inset 0 0 0 1px var(--line); overflow: hidden; background: #fff; }
  .cmp-tag { position: absolute; z-index: 2; left: 14px; top: 13px; font: 500 12px/1 var(--pixel); color: var(--ink-2); pointer-events: none; }
  /* with the script: one pane at a time, crossfading in place */
  .cmp.on .cmp-switch { display: grid; }
  .cmp.on .cmp-panes { grid-template-columns: 1fr; }
  .cmp.on .cmp-pane { grid-area: 1 / 1; opacity: 0; visibility: hidden; transition: opacity .22s var(--ease), visibility 0s .22s; }
  .cmp.on .cmp-pane[data-on] { opacity: 1; visibility: visible; transition: opacity .22s var(--ease), visibility 0s; }
  .cmp.on .cmp-tag { display: none; }
  figcaption { font: 400 15px/1.5 var(--display); color: var(--ink-2); margin-top: 14px; max-width: var(--text); }
  figcaption .px { font: 500 12px/1 var(--pixel); color: #fff; background: var(--ink); padding: 3px 6px 4px; margin-right: 6px; vertical-align: 1px; }
  @media (max-width: 640px) {
    .cmp-top, figcaption { padding-inline: var(--gut); }
    .cmp-panes { gap: 10px; grid-template-columns: 1fr; }
    .cmp-pane { border-radius: 0; box-shadow: inset 0 1px 0 var(--line), inset 0 -1px 0 var(--line); }
    .cmp-switch button { min-width: 0; padding: 0 12px; }
    /* on a phone the switch sits under the picture, where the thumb is */
    .cmp.on { display: flex; flex-direction: column; }
    .cmp.on .cmp-top { order: 2; margin: 12px 0 0; }
    .cmp.on .cmp-panes { order: 1; }
    .cmp.on figcaption { order: 3; }
  }
  @media (prefers-reduced-motion: reduce) { .cmp-ind, .cmp.on .cmp-pane { transition: none; } }
</style>
