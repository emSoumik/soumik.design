---
// <Demo name="stitch" label="fig. 2" caption="…" />: a live demo in a plain white frame, with a pixel label in the
// corner and a reset. the stage and its controls are drawn here at build time (so it holds its height and reads
// right without the script); the script that makes it move loads only as it nears the screen.
// bare: just the stage, for a demo inside a <Compare> pane
import Stitch from '../blog/demos/Stitch.astro';
import Tune from '../blog/demos/Tune.astro';
import Lift from '../blog/demos/Lift.astro';
import Room from '../blog/demos/Room.astro';
import Idle from '../blog/demos/Idle.astro';
import Mini from '../blog/demos/Mini.astro';

type Name = 'stitch' | 'tune' | 'lift' | 'room' | 'idle' | 'ink' | 'pixel';
interface Props { name: Name; label?: string; caption?: string; bare?: boolean }
const { name, label, caption, bare = false } = Astro.props;
const Inner = { stitch: Stitch, tune: Tune, lift: Lift, room: Room, idle: Idle, ink: Mini, pixel: Mini }[name];
---
{bare
  ? <div class="demo bare" data-demo={name}><Inner kind={name} /></div>
  : <figure class="bx demo" data-demo={name}>
      <div class="demo-frame">
        {label && <span class="demo-tag px" aria-hidden="true">{label}</span>}
        <button class="demo-reset" type="button" data-reset disabled><span class="px">reset</span></button>
        <Inner kind={name} />
      </div>
      {caption && <figcaption>{label && <span class="px">{label}</span>} <Fragment set:html={caption} /></figcaption>}
    </figure>}

<script>
  // each demo's script, loaded as it comes within a screen or so of the viewport
  type Mounted = { reset?: () => void } | void;
  const DEMOS: Record<string, () => Promise<{ mount: (el: HTMLElement) => Mounted }>> = {
    stitch: () => import('../blog/demos/stitch'),
    tune: () => import('../blog/demos/tune'),
    lift: () => import('../blog/demos/lift'),
    room: () => import('../blog/demos/room'),
    idle: () => import('../blog/demos/idle'),
    ink: () => import('../blog/demos/mini'),
    pixel: () => import('../blog/demos/mini'),
  };
  const io = new IntersectionObserver((es) => {
    for (const e of es) {
      if (!e.isIntersecting) continue;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      DEMOS[el.dataset.demo!]?.().then((m) => {
        const d = m.mount(el);
        el.classList.add('live');
        const reset = el.querySelector<HTMLButtonElement>(':scope > .demo-frame > [data-reset]');
        if (reset && d?.reset) { reset.disabled = false; reset.addEventListener('click', d.reset); }
      }).catch((err) => console.warn('demo unavailable', err));
    }
  }, { rootMargin: '600px 0px' });
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((el) => io.observe(el));
</script>

<style>
  .demo-frame { position: relative; border-radius: 16px; box-shadow: inset 0 0 0 1px var(--line); background: #fff; overflow: hidden; }
  .demo-tag { position: absolute; z-index: 3; left: 16px; top: 16px; font: 500 12px/1 var(--pixel); color: var(--ink-2); pointer-events: none; }
  .demo-reset { position: absolute; z-index: 3; right: 4px; top: 2px; min-width: 44px; min-height: 44px; padding: 0 12px; border: 0; background: none; color: var(--ink-2); cursor: pointer; font: 500 12px/1 var(--pixel); transition: color .2s var(--ease), transform .16s var(--ease), opacity .2s; }
  .demo-reset:disabled { opacity: 0; pointer-events: none; }
  .demo-reset { opacity: 1; }
  .demo-reset:active { transform: scale(.97); }
  .demo-reset:focus-visible, .demo :global(.dm-btn:focus-visible), .demo :global(.dm-seg button:focus-visible) { outline: 2px solid var(--ink); outline-offset: 1px; }
  .demo-reset .px { background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; padding-bottom: 3px; }
  figcaption { font: 400 15px/1.5 var(--display); color: var(--ink-2); margin-top: 14px; max-width: var(--text); text-wrap: pretty; }
  figcaption .px { font: 500 12px/1 var(--pixel); color: var(--ink); margin-right: 4px; }
  @media (hover: hover) and (pointer: fine) { .demo-reset:hover { color: var(--ink); } }

  /* ---- the parts every demo is built from: a stage, then a bar of controls under it, where a thumb reaches */
  .demo :global(.dm-stage) { position: relative; height: var(--dm-h, 340px); user-select: none; -webkit-user-select: none; }
  .demo :global(.dm-stage canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* a readout line on top, then the controls. the readout always owns its line, so a longer sentence never moves anything */
  .demo :global(.dm-bar) { display: flex; flex-wrap: wrap; align-items: center; gap: 0 12px; padding: 4px 12px 8px; border-top: 1px solid var(--line); }
  .demo :global(.dm-read) { order: -1; flex: 1 0 100%; display: block; min-height: 36px; padding: 11px 8px 0; font: 500 13px/1.3 var(--pixel); color: var(--ink-2); font-variant-numeric: tabular-nums; text-align: left; }
  .demo :global(.dm-read b) { font-weight: 500; color: var(--ink); }
  .demo :global(.dm-hint) { position: absolute; left: 0; right: 0; bottom: 14px; text-align: center; font: 500 12px/1 var(--pixel); color: var(--ink-3); pointer-events: none; transition: opacity .3s var(--ease); }
  .demo :global(.dm-hint.gone) { opacity: 0; }

  /* buttons: a quiet pixel word with an underline */
  .demo :global(.dm-btn) { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; border: 0; background: none; color: var(--ink); cursor: pointer; border-radius: 8px; font: 500 13px/1 var(--pixel); transition: transform .16s var(--ease), opacity .2s var(--ease); }
  .demo :global(.dm-btn span) { background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat; padding-bottom: 3px; }
  .demo :global(.dm-btn:disabled) { opacity: .35; cursor: default; }
  .demo :global(.dm-btn:not(:disabled):active) { transform: scale(.97); }
  .demo :global(.dm-btn.solid) { background: var(--ink); color: #fff; padding: 0 16px; border-radius: 99px; min-height: 40px; }
  .demo :global(.dm-btn.solid span) { background: none; padding: 0; }

  /* a two-way switch with an ink pill that slides between its sides */
  .demo :global(.dm-seg) { position: relative; display: inline-grid; grid-auto-flow: column; grid-auto-columns: 1fr; padding: 3px; border-radius: 99px; box-shadow: inset 0 0 0 1px var(--line); isolation: isolate; }
  .demo :global(.dm-seg button) { position: relative; z-index: 1; min-height: 38px; padding: 0 14px; border: 0; background: none; border-radius: 99px; color: var(--ink-2); cursor: pointer; font: 500 13px/1 var(--pixel); white-space: nowrap; transition: color .2s var(--ease), transform .16s var(--ease); }
  .demo :global(.dm-seg button::before) { content: ""; position: absolute; inset: -3px 0; }
  .demo :global(.dm-seg button[aria-checked=true]) { color: #fff; }
  .demo :global(.dm-seg button:not(:disabled):active) { transform: scale(.97); }
  .demo :global(.dm-seg button:disabled) { cursor: default; }
  .demo :global(.dm-seg i) { position: absolute; z-index: 0; top: 3px; bottom: 3px; left: 3px; width: calc(50% - 3px); border-radius: 99px; background: var(--ink); transition: transform .22s var(--ease); }
  .demo :global(.dm-seg[data-v="1"] i) { transform: translateX(100%); }

  /* a slider: hairline track, square pixel thumb, 44px to grab */
  .demo :global(.dm-range) { display: flex; align-items: center; gap: 10px; min-height: 44px; font: 500 12px/1 var(--pixel); color: var(--ink-2); }
  .demo :global(.dm-range input:focus-visible) { outline: 2px solid var(--ink); outline-offset: -8px; }
  .demo :global(.dm-range input) { appearance: none; -webkit-appearance: none; width: 140px; height: 44px; margin: 0; background: linear-gradient(var(--ink), var(--ink)) 0 50% / 100% 1px no-repeat; cursor: pointer; }
  .demo :global(.dm-range input:disabled) { opacity: .35; cursor: default; }
  .demo :global(.dm-range input::-webkit-slider-thumb) { -webkit-appearance: none; width: 14px; height: 14px; background: var(--ink); border-radius: 0; box-shadow: 0 0 0 3px #fff; }
  .demo :global(.dm-range input::-moz-range-thumb) { width: 14px; height: 14px; background: var(--ink); border: 0; border-radius: 0; box-shadow: 0 0 0 3px #fff; }

  @media (hover: hover) and (pointer: fine) {
    .demo :global(.dm-btn:not(:disabled):not(.solid):hover) { opacity: .7; }
    .demo :global(.dm-seg button[aria-checked=false]:not(:disabled):hover) { color: var(--ink); }
  }
  @media (max-width: 640px) {
    .demo-frame { border-radius: 0; box-shadow: inset 0 1px 0 var(--line), inset 0 -1px 0 var(--line); }
    figcaption { padding-inline: var(--gut); }
    .demo :global(.dm-stage) { height: var(--dm-hp, var(--dm-h, 300px)); }
    .demo :global(.dm-bar) { padding: 10px calc(var(--gut) - 8px) 12px; }
    .demo :global(.dm-seg) { display: grid; flex: 1 0 100%; margin: 4px 0; }
    .demo :global(.dm-range) { flex: 1 1 0; min-width: 0; }
    .demo :global(.dm-range input) { flex: 1; width: auto; min-width: 60px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo :global(.dm-seg i), .demo :global(.dm-btn), .demo :global(.dm-hint) { transition: none; }
  }
  .bare { height: 100%; }
  /* the build-time drawing gives way to the live one without a jump */
  .demo :global(.dm-still) { transition: opacity .3s var(--ease); }
  .demo.live :global(.dm-still) { opacity: 0; pointer-events: none; }
</style>
