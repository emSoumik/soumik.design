---
// <Screens device="phone" />: the WhyClub screens from the home page (js/work/slideshow.js), dropped into a post.
// stories across the top, a phone/desktop switch, tap or swipe to move on. it loads when it gets close
interface Props {
  device?: 'phone' | 'desktop';
  caption?: string;
}
const { device = 'phone', caption } = Astro.props;
---
<figure class="screens wide">
  <div class="host" data-device={device}></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screens { max-width: 820px; container-type: inline-size; }
  /* holds the slideshow's room until it mounts, so nothing jumps (measured: its header plus the stage) */
  .host:empty { aspect-ratio: 1 / .925; border-radius: 28px; background: var(--wash); }
  @container (max-width: 520px) { .host:empty { aspect-ratio: 1 / 1.25; } }
  figcaption { font: 400 13px/1.5 var(--mono); color: var(--ink-2); margin-top: 12px; text-align: center; }
</style>

<script>
  const io = new IntersectionObserver(async (entries) => {
    for (const { target, isIntersecting } of entries) {
      if (!isIntersecting) continue;
      io.unobserve(target);
      const { mountSlideshow } = await import('../../../js/work/slideshow.js');
      mountSlideshow(target as HTMLElement, { device: (target as HTMLElement).dataset.device });
    }
  }, { rootMargin: '40% 0px' });
  document.querySelectorAll('.screens .host').forEach((el) => io.observe(el));
</script>
