---
// the vayu page. the film first, growing to a wide, rounded frame as you scroll; then the problem, the idea as a before
// and after, a walk you can step through, the phone app, the decisions you can flip, the alerts you can feel, the look,
// and who did what.
// nothing here is a still from the film: every screen and drawing is made for the page
import '../project/project.css';
import Watch from './Watch.astro';
import Phone from './Phone.astro';
import BodyChart from './BodyChart.astro';
import WalkMap from './WalkMap.astro';
import Player from '../project/Player.astro';

const DEVPOST = 'https://devpost.com/software/vayu-ro0jfd';
const BRIEF = 'https://figbuild2026.devpost.com/';
const NOISE = 'https://support.apple.com/en-us/102315';
const A = '/assets/work/vayu/';
const C = { sindoor: '#E0301E', neem: '#22A04B', neel: '#2F3FBF', kesar: '#FF8A00', rani: '#E3197E' };

const walk = [
  { s: 'vitals', clock: '8:40', name: 'Leaving home', d: 3800, path: 'a', from: 0, to: .58, cap: '<b>8:40.</b> Vayu runs in the background. One score for how you’re breathing, the AQI under it.' },
  { s: 'air', clock: '8:52', name: 'The air turns', d: 3600, path: 'a', from: .58, to: 1, air: true, aqi: [64, 168], cap: '<b>8:52.</b> Rush hour at the junction. The AQI climbs, and a minute later so does your breathing.' },
  { s: 'alert-aqi', clock: '8:53', name: 'A tap', d: 3200, path: 'a', from: 1, to: 1, air: true, tap: C.sindoor, cap: '<b>8:53.</b> A strong tap on the wrist, like Noise in a loud room. The alert says what’s wrong in words.' },
  { s: 'routes', clock: '8:53', name: 'The way out', d: 3600, path: 'a', from: 1, to: 1, air: true, routes: true, cap: '<b>8:53.</b> The same alert offers routes. The park is cleaner and four minutes longer, and it says so.' },
  { s: 'turn', clock: '8:54', name: 'Follow the taps', d: 5200, path: 'b', from: 0, to: .82, air: true, cap: '<b>8:54.</b> Turn by turn on the wrist, called by taps, so your arm can stay down.' },
  { s: 'alert-clean', clock: '9:05', name: 'Clean air', d: 3400, path: 'b', from: .82, to: 1, tap: C.neem, cap: '<b>9:05.</b> A soft tap once you’re through. Then it goes quiet again.' },
];

// each decision: the idea it replaced (a: drawn as it was described, never shipped), what we kept (b), why, the cost
const calls = [
  { t: 'One glance, one decision.', a: 'x-all', b: 'vitals',
    la: 'The dropped idea: a watch screen crowded with the AQI, breathing, oxygen, a score, a chart and two routes.',
    lb: 'What we kept: one comfort score, 81, and where you are.',
    why: 'You look at a watch for a second or two, mid-walk. So the watch detects and acts, and the phone is where you go deeper: charts, history, the full map.',
    cost: 'most of what the app knows never reaches your wrist.' },
  { t: 'Never an alert without a way out.', a: 'x-number', b: 'alert-aqi',
    la: 'The dropped idea: an alert that only says AQI 160, unhealthy, with an OK button.',
    lb: 'What we kept: air is unhealthy, your breathing is up, with a button to see a cleaner way.',
    why: 'An AQI of 160 doesn’t change what you do. A tap that says your heart has been working hard for six minutes, with a cleaner route four minutes longer, does.',
    cost: 'every alert needs a route, a breathe or a direction ready, which makes alerts harder to design than numbers.' },
  { t: 'Show the trade honestly.', a: 'x-routes', b: 'routes',
    la: 'The dropped idea: one recommended route through the park, with no time and no other option.',
    lb: 'What we kept: the cleanest route at AQI 42 and four minutes longer, above the fastest at AQI 168.',
    why: 'The cleanest route can be slower, and the fastest usually runs through the worst air. Each route shows its air and its time side by side, and you choose.',
    cost: 'we can’t promise the healthiest choice is also the easy one.' },
  { t: 'No map on the watch.', a: 'x-map', b: 'turn',
    la: 'The dropped idea: a full street map squeezed onto the watch, with the haze, two routes and labels.',
    lb: 'What we kept: turn left, 120 metres into the park, air ahead 48.',
    why: 'Maps are dense; health screens are calm. Mid-commute we cut each moment down to one thing: the next turn and the air ahead.',
    cost: 'anyone who wants the full map has to take out their phone.' },
];

const alerts = [
  { s: 'alert-aqi', name: 'Air is unhealthy', when: 'The AQI crosses the line near you.', feel: 'Two strong taps', tone: C.sindoor, buzz: [220, 120, 220], n: 2 },
  { s: 'alert-breath', name: 'Slow your breath', when: 'Your breathing stays high.', feel: 'Three light taps', tone: C.neel, buzz: [70, 140, 70, 140, 70], n: 3 },
  { s: 'alert-spo2', name: 'Oxygen dipped', when: 'Your blood oxygen drops.', feel: 'Three long taps', tone: C.kesar, buzz: [320, 120, 320, 120, 320], n: 3 },
  { s: 'alert-clean', name: 'Clean air zone', when: 'You walk into clean air.', feel: 'One soft tap', tone: C.neem, buzz: [60], n: 1 },
];
const longest = Math.max(...alerts.map((a) => a.buzz.reduce((x, y) => x + y, 0)));


// the phone app's three tabs: which watch screen is beside each, how long each plays, what it says
const tabs = [
  { s: 'summary', w: 'vitals', name: 'Summary', hi: 'सारांश', d: 5600, cap: '<b>Summary.</b> One score for the air, 64 of 100, then the AQI on a single spectrum. Four pollutants sit under it, each against its guide value, and the watch shows the same moment.' },
  { s: 'routes', w: 'routes', name: 'Routes', hi: 'रास्ते', d: 5600, cap: '<b>Routes.</b> Two ways home, coloured by the air along them. The cleanest is seven minutes longer, the fastest runs through worse air, and each says so.' },
  { s: 'trends', w: 'air', name: 'Trends', hi: 'रुझान', d: 5600, cap: '<b>Trends.</b> The AQI for today: a solid line for what was measured, dotted for what’s modelled ahead, with the peak and the low called out.' },
];
const pigments = [
  { name: 'Mor', hi: 'मोर', hex: '#00A39A', role: 'Primary, calm' },
  { name: 'Rani', hi: 'रानी', hex: '#E3197E', role: 'Accent, hot pair of mor' },
  { name: 'Kesar', hi: 'केसर', hex: '#FF8A00', role: 'Sensitive · 101–150' },
  { name: 'Neel', hi: 'नील', hex: '#2F3FBF', role: 'Night, cool pair of kesar' },
  { name: 'Neem', hi: 'नीम', hex: '#22A04B', role: 'Good · 0–50' },
  { name: 'Haldi', hi: 'हल्दी', hex: '#F5B700', role: 'Moderate · 51–100' },
  { name: 'Sindoor', hi: 'सिंदूर', hex: '#E0301E', role: 'Unhealthy · 151–200' },
  { name: 'Jamun', hi: 'जामुन', hex: '#7A2F9A', role: 'Very unhealthy · 201–300' },
  { name: 'Manjistha', hi: 'मंजिष्ठा', hex: '#7A1F3D', role: 'Hazardous · 301+' },
  { name: 'Sona', hi: 'सोना', hex: '#C9971C', role: 'Hairlines and rings' },
];

const chapters: [number, string][] = [[0, 'The street'], [27, 'Your body knows'], [41, 'Designing for India'], [82, 'Vayu'], [92, 'The app and the watch']];
const json = (steps: object[]) => JSON.stringify(steps.map(({ cap, ...rest }: any) => rest));
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Tiro+Devanagari+Hindi&display=swap">

<article class="pj vy">
  <header class="vy-head">
    <div class="vy-head-in">
      <div>
        <div class="vy-title"><h1>Vayu <span lang="hi">वायु</span></h1><span class="vy-kindpill">concept</span></div>
        <p class="vy-one">A watch app that taps your wrist when the air turns bad and shows you a cleaner way through, and a phone app for the detail.</p>
      </div>
      <dl class="vy-facts">
        <div><dt>role</dt><dd>UX and interaction design</dd></div>
        <div class="vy-crew"><dt>team</dt><dd><a class="vy-person" href="https://x.com/soumikkhalder" target="_blank" rel="noopener"><picture><source srcset="/assets/work/vayu/people/soumik.avif" type="image/avif" /><img src="/assets/work/vayu/people/soumik.webp" alt="" width="30" height="30" loading="lazy" decoding="async" /></picture><span>Soumik Halder</span></a><a class="vy-person" href="https://x.com/pracosm" target="_blank" rel="noopener"><picture><source srcset="/assets/work/vayu/people/shardul.avif" type="image/avif" /><img src="/assets/work/vayu/people/shardul.webp" alt="" width="30" height="30" loading="lazy" decoding="async" /></picture><span>Shardul N</span></a></dd></div>
        <div><dt>for</dt><dd><a href={BRIEF} target="_blank" rel="noopener">FigBuild 2026</a></dd></div>
        <div><dt>when</dt><dd>March 2026</dd></div>
        <div><dt>write-up</dt><dd><a class="vy-site" href={DEVPOST} target="_blank" rel="noopener"><img src="/assets/brand/sites/devpost.png" alt="" width="16" height="16" decoding="async" />Devpost <span aria-hidden="true">↗</span></a></dd></div>
      </dl>
    </div>
  </header>

  <Player src={A + 'film-720.v2.mp4'} small={A + 'film-480.v2.mp4'} poster={A + 'title.webp'} duration={116} chapters={chapters} expand
    label="The Vayu film, 1 minute 56 seconds, with burned-in subtitles."
    caption="The film we made for the submission: the street, the science, the design language, then the product. Shardul shaped its look. It has sound, and subtitles burned in." />

  <!-- 01: the problem -->
  <section class="vy-sec" aria-labelledby="vy-h1">
    <div class="vy-cols">
      <div class="vy-text">
        <p class="vy-k"><span>01</span>the problem</p>
        <h2 id="vy-h1">You can’t feel bad air.</h2>
        <p>Bad air is part of the commute in most Indian cities. On a bad day the AQI sits in the hundreds, and a green park and a choked junction can be one street apart.</p>
        <ol class="vy-list">
          <li><strong>You can’t feel it.</strong> Your breathing speeds up and your heart works harder before you notice anything. You feel it later, as a tired evening.</li>
          <li><strong>The numbers don’t help.</strong> An AQI of 168 on your phone doesn’t tell you what to do at the next corner.</li>
          <li><strong>Maps don’t care.</strong> Navigation sends you down the same road whether the air on it is clean or not.</li>
        </ol>
      </div>
      <aside class="vy-note">
        <b>the brief</b>
        <p><a href={BRIEF} target="_blank" rel="noopener">FigBuild 2026</a>, Figma’s student design-a-thon, asked for a tool that tracks a human sense. We picked chemoreception: your body senses carbon dioxide building up in your blood and makes you breathe harder. Bad air makes that stronger, and a smartwatch already reads most of the signals.</p>
      </aside>
    </div>
    <figure class="vy-fig">
      <div class="vy-stage" data-in><BodyChart /></div>
      <figcaption class="vy-cap">One walk to work. The air turns at the junction, and your body follows within a minute. That minute is where Vayu acts.</figcaption>
    </figure>
  </section>

  <!-- 02: the idea, the first before and after -->
  <section class="vy-sec" aria-labelledby="vy-h2">
    <div class="vy-cols is-side">
      <div class="vy-text">
        <p class="vy-k"><span>02</span>the idea</p>
        <h2 id="vy-h2">Do for the air what the watch already does for noise.</h2>
        <p>It came from a feature already on my wrist. Apple Watch’s <a href={NOISE} target="_blank" rel="noopener">Noise app</a> listens to the sound around you, and if it stays loud long enough to hurt your hearing, it taps your wrist. No app to open, no number to read.</p>
        <p>Nothing like that exists for the air. A watch already has the sensors and the GPS. Add the air at that spot, and it can warn you the same way, then show you a way out.</p>
      </div>
      <figure class="vy-fig vy-pair-fig">
        <div class="vy-stage vy-pair" data-in>
          <div><Watch screens={['noise']} label="A noise alert on a watch: it's loud here, 92 decibels for 3 minutes" /><p><small>before</small>Noise, today</p></div>
          <div><Watch screens={['alert-aqi']} label="A Vayu alert on a watch: air is unhealthy, AQI crossed 150 near you" /><p><small>after</small>Vayu, for the air</p></div>
        </div>
        <figcaption class="vy-cap">Same move, different sense: notice it, tap the wrist, say it in words.</figcaption>
      </figure>
    </div>
  </section>

  <!-- 03: the walk, the centrepiece -->
  <section class="vy-sec" aria-labelledby="vy-h3">
    <div class="vy-cols">
      <div class="vy-text">
        <p class="vy-k"><span>03</span>a walk with vayu</p>
        <h2 id="vy-h3">One walk to the office.</h2>
        <p>From the first glance at 8:40 to the last tap at 9:05. The map is the street; the watch is what you see on your wrist.</p>
      </div>
    </div>
    <figure class="vy-stage vy-walk" data-walk={json(walk)} tabindex="-1" aria-label="A walk with Vayu, step by step. The left and right arrow keys step through it." data-in>
      <div class="vy-walk-vis">
        <div class="vy-walk-map"><WalkMap /></div>
        <div class="vy-walk-watch"><Watch screens={walk.map((w) => w.s)} label="The Vayu watch during the walk" /></div>
      </div>
      <div class="vy-walk-foot">
        <div class="vy-steps">
          <div class="vy-steps-row" role="group" aria-label="Steps of the walk">
            {walk.map((w, i) => <button type="button" data-step={i} aria-current={i === 0 ? 'step' : undefined} tabindex={i ? -1 : 0}><span class="t">{w.clock}</span>{w.name}</button>)}
          </div>
        </div>
        <div class="vy-walk-ctl">
          <span class="vy-keys" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd> to step</span>
          <button type="button" class="vy-pp" data-pp aria-label="Pause the walk">
            <svg class="i-pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="2.6" height="10" rx=".8"/><rect x="9.4" y="3" width="2.6" height="10" rx=".8"/></svg>
            <svg class="i-play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3.3v9.4a.6.6 0 0 0 .92.5l7.3-4.7a.6.6 0 0 0 0-1l-7.3-4.7A.6.6 0 0 0 5 3.3Z"/></svg>
          </button>
        </div>
        <div class="vy-caps" data-live aria-live="off">
          {walk.map((w, i) => <p data-cap class:list={{ on: i === 0 }} set:html={w.cap} />)}
        </div>
      </div>
    </figure>
  </section>

  <!-- 04: the phone app -->
  <section class="vy-sec" aria-labelledby="vy-h4">
    <div class="vy-cols">
      <div class="vy-text">
        <p class="vy-k"><span>04</span>the phone app</p>
        <h2 id="vy-h4">The watch decides. The phone is where you look closer.</h2>
        <p>Shardul designed the first phone app at FigBuild, below. It goes for a retro, bold, unapologetically Indian look: truck-art energy, chunky outlines, big Devanagari. It makes a great poster. It’s hard to live with every day, because every card is loud and the contrast and the hierarchy fight each other.</p>
      </div>
    </div>
    <figure class="vy-fig">
      <div class="vy-stage vy-concept" data-in>
        <picture>
          <source srcset="/assets/work/vayu/concept-v1.avif" type="image/avif">
          <img src="/assets/work/vayu/concept-v1.webp" width="1310" height="936" loading="lazy" decoding="async" alt="The first Vayu phone concept: three screens on a cream ground with chunky black outlines and hard offset shadows. Home shows breathing comfort in rani pink, Navigate shows route options on a map in kesar orange, and Profile has a Hindi and Kannada language switch and smartwatch pairing in haldi and jamun.">
        </picture>
      </div>
      <figcaption class="vy-cap">The first concept, FigBuild 2026. The pigments and the two scripts came from here.</figcaption>
    </figure>
    <div class="vy-cols vy-after">
      <div class="vy-text">
        <p>Afterwards I redesigned it on the structure of Apple Health: a Summary, the Routes, the Trends, and a floating dock. The pigments and the two scripts stayed, and the app got the calm of a health app. It runs on the same pigments as the watch.</p>
      </div>
    </div>
    <figure class="vy-stage vy-walk vy-app" data-app={json(tabs)} tabindex="-1" aria-label="The Vayu phone app, tab by tab. The left and right arrow keys step through it." data-in>
      <div class="vy-app-vis">
        <div class="vy-app-phone"><Phone /></div>
        <div class="vy-app-watch">
          <Watch screens={['vitals', 'routes', 'air']} data="app" label="The Vayu watch showing the same moment as the phone" />
          <p><small>on the wrist</small>the same moment</p>
        </div>
      </div>
      <div class="vy-walk-foot">
        <div class="vy-steps">
          <div class="vy-steps-row" role="group" aria-label="Tabs of the phone app">
            {tabs.map((t, i) => <button type="button" data-step={i} aria-current={i === 0 ? 'step' : undefined} tabindex={i ? -1 : 0}><span class="t">{String(i + 1).padStart(2, '0')}</span>{t.name} <span lang="hi">{t.hi}</span></button>)}
          </div>
        </div>
        <div class="vy-walk-ctl">
          <span class="vy-keys" aria-hidden="true"><kbd>←</kbd><kbd>→</kbd> to step</span>
          <button type="button" class="vy-pp" data-pp aria-label="Pause the phone app">
            <svg class="i-pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><rect x="4" y="3" width="2.6" height="10" rx=".8"/><rect x="9.4" y="3" width="2.6" height="10" rx=".8"/></svg>
            <svg class="i-play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 3.3v9.4a.6.6 0 0 0 .92.5l7.3-4.7a.6.6 0 0 0 0-1l-7.3-4.7A.6.6 0 0 0 5 3.3Z"/></svg>
          </button>
        </div>
        <div class="vy-caps" data-live aria-live="off">
          {tabs.map((t, i) => <p data-cap class:list={{ on: i === 0 }} set:html={t.cap} />)}
        </div>
      </div>
    </figure>
  </section>

  <!-- 05: decisions, each a before and after you can flip -->
  <section class="vy-sec" aria-labelledby="vy-h5">
    <div class="vy-cols">
      <div class="vy-text">
        <p class="vy-k"><span>05</span>decisions</p>
        <h2 id="vy-h5">Most of the work was deciding what not to show.</h2>
        <p>Each card shows an idea we dropped, redrawn for this page, then what we kept and what it cost. Flip them.</p>
      </div>
    </div>
    <div class="vy-calls">
      {calls.map((c, n) => (
        <article class="vy-call" data-call data-state="first">
          <div class="vy-call-stage" data-in>
            <span class="vy-tag" data-tag aria-hidden="true">the idea we dropped</span>
            <Watch screens={[c.a, c.b]} label={c.la} />
            <div class="vy-seg" role="radiogroup" aria-label={`${c.t} Show the first idea or what we kept`}>
              <button type="button" role="radio" aria-checked="true" data-s={c.a} data-label={c.la}>First idea</button>
              <button type="button" role="radio" aria-checked="false" tabindex="-1" data-s={c.b} data-label={c.lb}>What we kept</button>
            </div>
          </div>
          <h3><span>{String(n + 1).padStart(2, '0')}</span>{c.t}</h3>
          <p>{c.why}</p>
          <p class="vy-cost"><b>The cost:</b> {c.cost}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- 05: four alerts, four taps -->
  <section class="vy-sec" aria-labelledby="vy-h6">
    <div class="vy-cols">
      <div class="vy-text">
        <p class="vy-k"><span>06</span>four alerts</p>
        <h2 id="vy-h6">Four alerts you can tell apart without looking.</h2>
        <p>Each alert has its own tap. Tap a watch to see it buzz and its rhythm play; on a phone, you’ll feel it too.</p>
      </div>
    </div>
    <div class="vy-stage vy-alerts" data-in>
      {alerts.map((a) => {
        const total = a.buzz.reduce((x, y) => x + y, 0);
        const segs = a.buzz.map((ms, k) => (k % 2 ? <b style={`flex: ${ms}`}></b> : <i style={`flex: ${ms}`}></i>));
        return (
          <button type="button" class="vy-alert" data-buzz={JSON.stringify(a.buzz)} data-tone={a.tone} style={`--buzz: ${a.n}; --tone: ${a.tone}`} aria-label={`${a.name}: ${a.feel}. Play it`}>
            <Watch screens={[a.s]} label={a.name} />
            <span class="vy-alert-t">{a.name}</span>
            <span class="vy-alert-w">{a.when}</span>
            <span class="vy-pat" style={`width: ${Math.max(6, (total / longest) * 100).toFixed(1)}%`} aria-hidden="true"><span>{segs}</span><span class="is-lit">{segs}</span></span>
            <span class="vy-alert-f">{a.feel}</span>
          </button>
        );
      })}
    </div>
  </section>

  <!-- 06: the look -->
  <section class="vy-sec" aria-labelledby="vy-h7">
    <div class="vy-cols">
      <div class="vy-text">
        <p class="vy-k"><span>07</span>the look</p>
        <h2 id="vy-h7">Indian roots, calmed down for daily use.</h2>
        <p>Shardul built the film and the first phone app on Indian pop art: truck art, old film posters, hand-painted shop signs. Bold colour, high contrast, two scripts on every screen.</p>
        <p>After FigBuild I redesigned the watch in Figma Make, then the phone app. I kept the roots and calmed them down for something you look at all day. The pigments are saturated and come in hot and cool pairs, rani with mor, kesar with neel, tied together with sona gold. The air isn’t five blocks of colour but one continuous spectrum. Devanagari runs at full weight beside the Latin, and a modern serif and a lotus for alerts finish it.</p>
      </div>
      <aside class="vy-note">
        <b>the name</b>
        <p><span class="vy-word" lang="hi" aria-hidden="true">वायु</span>Vayu is Sanskrit for air and wind. In Hindu stories Vayu is the god of the wind, and in yoga the five vayus are the ways breath moves through the body. A word most people in India already know.</p>
      </aside>
    </div>
    <figure class="vy-fig" data-look>
      <div class="vy-stage vy-look" data-in>
        <div class="vy-look-watch"><Watch screens={['vitals', 'air', 'routes', 'breathe']} label="The Vayu watch face" /></div>
        <div class="vy-look-side">
          <div class="vy-look-ctl">
            <div class="vy-ctl"><span aria-hidden="true">face</span>
              <div class="vy-seg" role="radiogroup" aria-label="Face" data-switch="face">
                <button type="button" role="radio" aria-checked="true" data-v="din">Day <span lang="hi">दिन</span></button>
                <button type="button" role="radio" aria-checked="false" tabindex="-1" data-v="raat">Night <span lang="hi">रात</span></button>
              </div>
            </div>
            <div class="vy-ctl"><span aria-hidden="true">case</span>
              <div class="vy-seg" role="radiogroup" aria-label="Watch" data-switch="shape">
                <button type="button" role="radio" aria-checked="true" data-v="sq">Square</button>
                <button type="button" role="radio" aria-checked="false" tabindex="-1" data-v="ci">Round</button>
              </div>
            </div>
            <div class="vy-ctl"><span aria-hidden="true">screen</span>
              <div class="vy-seg" role="radiogroup" aria-label="Screen" data-switch="screen">
                {['vitals', 'air', 'routes', 'breathe'].map((s, i) => <button type="button" role="radio" aria-checked={String(i === 0)} tabindex={i ? -1 : undefined} data-v={s}>{['Vitals', 'Air', 'Routes', 'Breathe'][i]}</button>)}
              </div>
            </div>
          </div>
          <ul class="vy-pig" aria-label="The palette">
