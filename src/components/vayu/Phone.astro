---
// the vayu phone app, rebuilt in html and css after the redesign: summary, routes and trends on one phone, with the
// floating dock. everything is drawn at the app's own size (402 x 874) and scaled down with one transform, so the
// numbers below are the app's real px. vayu.ts flips the .on screen and slides the dock pill; the screen is hidden
// from assistive tech (the steps under the stage are the real controls)
const wind = 'M3 8h10a3 3 0 1 0-3-3M3 12h14a3 3 0 1 1-3 3M3 16h6';
const rows = [
  { n: 'PM2.5', v: 12, g: 60, c: '#22A04B' },
  { n: 'PM10', v: 17, g: 100, c: '#22A04B' },
  { n: 'NO₂', v: 2, g: 80, c: '#22A04B' },
  { n: 'O₃', v: 133, g: 100, c: '#E0301E' },
];
// the chart: x is hours (0 to 24), y is AQI (0 to 150)
const X = (h: number) => 4 + (h / 24) * 300, Y = (a: number) => 156 - a * .973;
const past: [number, number][] = [[0, 101], [3, 100], [6, 98], [9, 95], [12, 90]];
const ahead: [number, number][] = [[12, 90], [15, 88], [18, 86], [21, 83], [24, 80]];
const pts = (a: [number, number][]) => a.map(([h, v]) => `${X(h).toFixed(1)} ${Y(v).toFixed(1)}`);
const pastLine = 'M' + pts(past).join(' L');
const pastArea = `${pastLine} L${X(12)} ${Y(0)} L${X(0)} ${Y(0)}Z`;
const aheadLine = 'M' + pts(ahead).join(' L');
---
<div class="ph" data-phone data-tab="summary" role="img" aria-label="The Vayu phone app, recreated for this page: a Summary, a Routes and a Trends screen.">
  <div class="ph-fit">
    <div class="ph-screen" aria-hidden="true">
      <span class="ph-island"></span>
      <p class="ph-status"><b>9:41</b><span><i></i><i></i><i></i></span></p>

      <!-- summary -->
      <section class="ph-s s-sum on" data-s="summary">
        <header class="ph-h">
          <div><p class="ph-date">Friday, 13 Nov</p><h4>Summary</h4></div>
          <span class="ph-btns">
            <i class="ph-round"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 0 0-14-4L4 9M4 4v5h5M4 13a8 8 0 0 0 14 4l2-2M20 20v-5h-5"/></svg></i>
            <i class="ph-round is-me"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8.5" r="3.6"/><path d="M5 20c.8-3.6 3.7-5.4 7-5.4s6.2 1.8 7 5.4"/></svg></i>
          </span>
        </header>

        <div class="ph-card dr rise" style="--dl: .05s">
          <p class="ph-ct is-mor"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d={wind}/></svg>Air Comfort<em class="ph-chip is-neel">Derived</em></p>
          <div class="ph-comfort">
            <div class="ph-ring">
              <svg viewBox="0 0 100 100">
                <defs><linearGradient id="ph-rg" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#00A39A"/><stop offset="1" stop-color="#22A04B"/></linearGradient></defs>
                <circle cx="50" cy="50" r="42" class="ph-track"/>
                <circle cx="50" cy="50" r="42" class="ph-arc dr arc" pathLength="100" stroke="url(#ph-rg)" style="--v: 64; --dl: .2s; --d: 1.1s"/>
              </svg>
              <b>64</b><small>of 100</small>
            </div>
            <div class="ph-fair">
              <h5>Fair</h5><p class="ph-hi" lang="hi">ठीक-ठाक</p>
              <p class="ph-sm">Worked out from US AQI 90 near Indiranagar. It describes the air, not your body.</p>
            </div>
          </div>
        </div>

        <div class="ph-card dr rise" style="--dl: .15s">
          <p class="ph-ct is-haldi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d={wind}/></svg>Air Quality<span class="ph-where">Indiranagar</span><em class="ph-chip is-mor">Modelled</em><svg class="ph-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></p>
          <div class="ph-aqi">
            <p class="ph-big"><b>90</b>AQI</p>
            <p class="ph-band"><b>Moderate</b><span lang="hi">मध्यम</span></p>
          </div>
          <div class="ph-spec">
            <i></i>
            <b class="dr slide" style="--x: 30; --dl: .35s; --d: 1s"></b>
          </div>
          <p class="ph-ticks"><span>0</span><span style="left: 16.7%">50</span><span style="left: 33.3%">100</span><span style="left: 50%">150</span><span style="left: 66.7%">200</span><span style="right: 0">300</span></p>
          <p class="ph-sm is-pad">Updated just now</p>
          <ul class="ph-poll">
            {rows.map((r, k) => <li><small>{r.n}</small><b>{r.v}</b><span><i class="dr grow" style={`--to: ${Math.min(1, r.v / r.g).toFixed(3)}; background: ${r.c}; --dl: ${(.45 + k * .08).toFixed(2)}s`}></i></span><em>guide {r.g}</em></li>)}
          </ul>
          <p class="ph-note">µg/m³ · bar shows the share of the guide value</p>
        </div>

        <h5 class="ph-sec">Pinned<span>Show All</span></h5>
        <div class="ph-two">
          <div class="ph-card is-mini"><p class="ph-ct is-kesar">Air Score<svg class="ph-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></p><p class="ph-big is-s"><b>56</b>pts</p></div>
          <div class="ph-card is-mini"><p class="ph-ct is-mor">PM2.5<svg class="ph-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></p><p class="ph-big is-s"><b>12</b>µg/m³</p></div>
        </div>
      </section>

      <!-- routes -->
      <section class="ph-s s-rt" data-s="routes">
        <header class="ph-h"><div><p class="ph-date" lang="hi">साफ़ हवा वाले रास्ते</p><h4>Routes</h4></div></header>
        <div class="ph-card ph-ft dr rise" style="--dl: .05s">
          <p><i class="ph-dot"></i><small>From · <span lang="hi">से</span></small><b>Home</b></p>
          <p><svg viewBox="0 0 24 24" fill="#E3197E"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12zm0-9a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg><small>To · <span lang="hi">तक</span></small><b>Cubbon Park</b></p>
        </div>
        <div class="ph-mode dr rise" style="--dl: .1s"><span class="on">Walk <em lang="hi">पैदल</em></span><span>Cycle <em lang="hi">साइकिल</em></span><span>Drive <em lang="hi">गाड़ी</em></span></div>
        <div class="ph-map dr rise" style="--dl: .15s">
          <svg viewBox="0 0 370 236">
            <rect width="370" height="236" fill="#ECEBF3"/>
            <path d="M0 214 L120 214 L120 150 L0 150Z M150 30 L220 30 L220 110 L150 110Z M250 140 L370 140 L370 236 L250 236Z" fill="#E1E0EC"/>
            <rect x="40" y="54" width="92" height="72" rx="14" fill="#22A04B" opacity=".2"/>
            <circle cx="62" cy="78" r="6" fill="#22A04B" opacity=".3"/><circle cx="90" cy="64" r="7" fill="#22A04B" opacity=".3"/><circle cx="106" cy="100" r="6" fill="#22A04B" opacity=".3"/><circle cx="72" cy="108" r="5" fill="#22A04B" opacity=".3"/>
            <g fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M0 196 L130 196 L180 150 L260 150 L310 100 L370 52"/><path d="M70 236 L70 40 M220 0 L220 236 M0 126 L370 126"/>
            </g>
            <g class="ph-routes dr wipe" style="--dl: .4s; --d: 1.3s" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <g class="ph-fast" stroke-width="5">
                <path d="M36 196 L130 196 L180 150" stroke="#F5B700"/><path d="M180 150 L260 150" stroke="#FF8A00"/><path d="M260 150 L310 100" stroke="#E0301E"/><path d="M310 100 L334 56" stroke="#FF8A00"/>
              </g>
              <g stroke-width="7">
                <path d="M36 196 L70 196 L70 130" stroke="#22A04B"/><path d="M70 130 L130 130 L130 80" stroke="#22A04B"/><path d="M130 80 L240 80 L240 56" stroke="#9CC63A"/><path d="M240 56 L334 56" stroke="#22A04B"/>
              </g>
            </g>
            <circle cx="36" cy="196" r="9" fill="#fff" stroke="#00A39A" stroke-width="4"/>
            <g transform="translate(334 56)"><circle r="12" fill="#E3197E" stroke="#fff" stroke-width="3"/><text y="4.5" text-anchor="middle" fill="#fff" font-size="13" font-weight="700">B</text></g>
            <g class="ph-pin"><rect x="196" y="58" width="82" height="22" rx="11" fill="#fff"/><text x="237" y="73.5" text-anchor="middle" font-size="12" font-weight="600" fill="#1B7A3A">AQI 62 · 29 min</text></g>
            <g class="ph-pin"><rect x="228" y="164" width="86" height="22" rx="11" fill="#fff"/><text x="271" y="179.5" text-anchor="middle" font-size="12" font-weight="600" fill="#B85A00">AQI 118 · 22 min</text></g>
          </svg>
          <p class="ph-leg"><span>cleaner air</span><i></i><span>worse air</span></p>
        </div>
        <h6 class="ph-k" lang="hi">सुझाए गए मार्ग</h6>
        <div class="ph-rows">
          <div class="ph-row is-pick dr rise" style="--dl: .3s">
            <span class="ph-tile" style="background: #22A04B"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c-5 0-8-3-8-8 0-4 3-8 9-9 4 0 7 3 7 7 0 6-4 10-8 10zM9 15c1-3 3-5 6-6"/></svg></span>
            <span class="ph-rt"><b>Park-side streets</b><span><em class="ph-chip is-neem">Cleanest</em>+7 min · 6.9 km</span></span>
            <span class="ph-rv"><b style="color: #1B7A3A">62</b><small>AQI · 29 min</small></span>
          </div>
          <div class="ph-row dr rise" style="--dl: .4s">
            <span class="ph-tile" style="background: #FF8A00"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 5 13h6l-1 8 8-10h-6z"/></svg></span>
            <span class="ph-rt"><b>MG Road direct</b><span><em class="ph-chip is-kesar">Fastest</em>5.8 km</span></span>
            <span class="ph-rv"><b style="color: #B85A00">118</b><small>AQI · 22 min</small></span>
          </div>
        </div>
      </section>

      <!-- trends -->
      <section class="ph-s s-tr" data-s="trends">
        <header class="ph-h"><div><p class="ph-date" lang="hi">रुझान</p><h4>Trends</h4></div></header>
        <div class="ph-seg dr rise" style="--dl: .05s"><span class="on">Day</span><span>Week</span></div>
        <div class="ph-card dr rise" style="--dl: .1s">
          <p class="ph-ct is-kesar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d={wind}/></svg>AQI Today<span class="ph-where" lang="hi">आज</span></p>
          <div class="ph-pk">
            <p><small>PEAK AQI</small><b class="is-k">101</b><span>around 12 AM</span></p>
            <p><small>LOWEST</small><b class="is-h">81</b><span>around 11 PM</span></p>
          </div>
          <p class="ph-now"><b>90</b>12 PM</p>
          <svg class="ph-chart" viewBox="0 0 336 176">
            <g stroke="rgba(20,18,58,.1)">{[0, 50, 100, 150].map((a) => <line x1="4" x2="304" y1={Y(a)} y2={Y(a)}/>)}</g>
            <g fill="rgba(20,18,58,.4)" font-size="11" text-anchor="end">{[0, 50, 100, 150].map((a) => <text x="332" y={Y(a) + 4}>{a}</text>)}</g>
            <g class="dr wipe" style="--dl: .35s; --d: 1.2s">
              <rect x="4" y={Y(50)} width={X(12) - 4} height={Y(0) - Y(50)} fill="#22A04B" opacity=".14"/>
              <path d={pastArea} fill="#F5B700" opacity=".16" stroke="none"/>
              <path d={pastLine} fill="none" stroke="#F5B700" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx={X(0)} cy={Y(101)} r="5" fill="#fff" stroke="#FF8A00" stroke-width="2.5"/>
            </g>
            <line x1={X(12)} x2={X(12)} y1="6" y2={Y(0)} stroke="#14123A" stroke-dasharray="2 3" opacity=".7"/>
            <g class="dr wipe" style="--dl: 1.5s; --d: 1s"><path d={aheadLine} fill="none" stroke="#F5B700" stroke-width="3" stroke-linecap="round" stroke-dasharray="0.1 6"/></g>
            <circle cx={X(12)} cy={Y(90)} r="6" fill="#fff" stroke="#F5B700" stroke-width="3"/>
            <g fill="rgba(20,18,58,.5)" font-size="11">{[[0, '12a'], [6, '6a'], [12, '12p'], [18, '6p']].map(([h, t]) => <text x={X(h as number)} y="172">{t}</text>)}</g>
          </svg>
          <p class="ph-legend"><span class="is-solid">Earlier today</span><span class="is-solid">Modelled ahead</span></p>
        </div>
        <div class="ph-card dr rise" style="--dl: .25s">
          <p class="ph-ct is-mor"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d={wind}/></svg>Pollutants<em class="ph-chip is-mor">Modelled</em></p>
          <p class="ph-pol"><b>PM2.5</b><strong>12<small>µg/m³</small></strong></p>
          <p class="ph-within">Within guide · <span lang="hi">मानक के भीतर</span></p>
        </div>
      </section>

      <!-- the dock -->
      <nav class="ph-dock" data-dock style="--i: 0">
        <i class="ph-pill"></i>
        <button type="button" tabindex="-1" data-tab="0" class="on"><svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span>Summary · <em lang="hi">सारांश</em></span></button>
        <button type="button" tabindex="-1" data-tab="1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14"/></svg><span>Routes · <em lang="hi">रास्ते</em></span></button>
        <button type="button" tabindex="-1" data-tab="2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4v16h16M7 15l4-4 3 3 5-6"/></svg><span>Trends · <em lang="hi">रुझान</em></span></button>
      </nav>
    </div>
  </div>
</div>

<style>
  /* the device: a dark bezel round a screen drawn at the app's own 402 x 874 and scaled to fit by --k */
  .ph { --k: .8; --ink: #14123A; --mute: rgba(20, 18, 58, .58); --line: rgba(20, 18, 58, .08); --sona: #C9971C;
    position: relative; flex: none; width: calc(402px * var(--k) + 20px); padding: 10px; border-radius: calc(50px * var(--k) + 10px); background: #14123A;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, .14), 0 0 0 1px rgba(20, 18, 58, .5), 0 28px 50px -24px rgba(20, 18, 58, .45), 0 8px 18px -8px rgba(20, 18, 58, .25); }
  .ph-fit { position: relative; width: calc(402px * var(--k)); height: calc(874px * var(--k)); overflow: hidden; border-radius: calc(50px * var(--k)); background: #F6F3FA; isolation: isolate; }
  .ph-screen { position: absolute; left: 0; top: 0; width: 402px; height: 874px; transform: scale(var(--k)); transform-origin: 0 0; overflow: hidden; background: #F6F3FA;
    font: 400 15px/1.3 var(--display); color: var(--ink); text-align: left; -webkit-font-smoothing: antialiased; }
  .ph-screen :is(p, h4, h5, h6, ul) { margin: 0; padding: 0; }
  .ph-screen [lang="hi"] { font-family: "Tiro Devanagari Hindi", "Kohinoor Devanagari", serif; font-weight: 400; font-style: normal; }
  .ph-screen em { font-style: normal; }
  .ph-screen svg { display: block; }
  .ph-island { position: absolute; z-index: 5; left: 50%; top: 11px; width: 120px; height: 34px; margin-left: -60px; border-radius: 20px; background: #000; }
  .ph-screen .ph-status { position: absolute; z-index: 4; left: 0; right: 0; top: 26px; display: flex; justify-content: space-between; padding: 0 46px 0 58px; font: 600 15px/1 var(--display); }
  .ph-status span { display: flex; gap: 4px; align-items: center; }
  .ph-status i { width: 5px; height: 11px; border-radius: 2px; background: var(--ink); }
  .ph-status i:nth-child(1) { height: 7px; } .ph-status i:nth-child(3) { width: 22px; height: 11px; border-radius: 4px; }

  /* screens cross-fade; the one that's on lays its pieces in */
  .ph-s { position: absolute; inset: 0; padding: 62px 16px 0; opacity: 0; visibility: hidden; transition: opacity .3s var(--pj-ease), visibility 0s .3s; }
  .ph-s.on { opacity: 1; visibility: visible; transition: opacity .35s var(--pj-ease) .1s, visibility 0s; }
  .s-sum { background: linear-gradient(180deg, #F9EBD0 0, #F6F3FA 200px); }
  .s-rt { background: linear-gradient(180deg, #D3D5F0 0, #F6F3FA 220px); }
  .ph-h { display: flex; justify-content: space-between; align-items: flex-end; padding: 0 4px; margin-bottom: 14px; }
  .ph-date { font-size: 14px; font-weight: 500; color: rgba(20, 18, 58, .62); }
  .ph h4, .ph-h h4 { font: 700 34px/1.1 var(--display); letter-spacing: -.02em; }
  .ph-btns { display: flex; gap: 12px; }
  .ph-round { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(20, 18, 58, .08); color: var(--ink); }
  .ph-round svg { width: 20px; height: 20px; }
  .ph-round.is-me { background: linear-gradient(135deg, #00A39A, #2F3FBF 55%, #E3197E); box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--sona); }

  .ph-card { position: relative; margin-bottom: 12px; padding: 16px 18px; border-radius: 20px; background: #fff; box-shadow: 0 1px 2px rgba(20, 18, 58, .04); }
  .ph-ct { display: flex; align-items: center; gap: 8px; font: 600 17px/1.2 var(--display); }
  .ph-ct svg:first-child { width: 20px; height: 20px; flex: none; }
  .ph-ct.is-mor { color: #00716C; } .ph-ct.is-haldi { color: #8A6100; } .ph-ct.is-kesar { color: #B85A00; }
  .ph-ct > .ph-where, .ph-ct > .ph-chip { margin-left: auto; }
  .ph-chip { padding: 3px 11px; border-radius: 99px; font: 600 13px/1.4 var(--display); }
  .ph-chip.is-neel { color: #2431A0; background: #E4E3F6; } .ph-chip.is-mor { color: #00716C; background: #D9F0EE; }
  .ph-chip.is-neem { color: #1B7A3A; background: #DDF1E3; } .ph-chip.is-kesar { color: #B85A00; background: #FFE9CC; }
  .ph-where { font: 400 15px/1 var(--display); color: rgba(20, 18, 58, .5); }
  .ph-ct > .ph-where + .ph-chip { margin-left: 0; }
  .ph-chev { width: 18px; height: 18px; color: rgba(20, 18, 58, .5); flex: none; }
  .is-mini .ph-chev { margin-left: auto; }

  .ph-comfort { display: grid; grid-template-columns: 124px 1fr; gap: 20px; align-items: center; margin-top: 10px; }
  .ph-ring { position: relative; display: grid; place-items: center; }
  .ph-ring svg { width: 124px; height: 124px; rotate: -90deg; }
  .ph-track, .ph-arc { fill: none; stroke-width: 12; }
  .ph-track { stroke: #DBEFE3; }
  .ph-arc { stroke-linecap: round; stroke-dasharray: 100 100; }
  .ph-ring b { position: absolute; top: 33px; font: 700 40px/1 var(--display); letter-spacing: -.02em; }
  .ph-ring small { position: absolute; top: 76px; font-size: 14px; color: var(--mute); }
  .ph-fair h5 { font: 700 29px/1.1 var(--display); letter-spacing: -.01em; }
  .ph-hi { margin-top: 2px; font-size: 19px; color: #8A6100; }
  .ph-sm { margin-top: 8px; font-size: 14.5px; line-height: 1.45; color: var(--mute); }
  .ph-sm.is-pad { margin-top: 12px; }

  .ph-aqi { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 12px; }
  .ph-big { display: flex; align-items: baseline; gap: 8px; font: 500 20px/1 var(--display); color: var(--mute); }
  .ph-big b { font: 700 52px/1 var(--display); letter-spacing: -.02em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .ph-big.is-s { margin-top: 10px; font-size: 14px; } .ph-big.is-s b { font-size: 40px; }
  .ph-band { display: grid; justify-items: end; gap: 3px; padding-top: 10px; }
  .ph-band b { font: 700 22px/1.1 var(--display); color: #8A6100; } .ph-band span { font-size: 16px; color: var(--mute); }
  .ph-spec { position: relative; height: 10px; margin-top: 12px; border-radius: 5px; background: linear-gradient(90deg, #22A04B 4%, #F5B700 25%, #FF8A00 42%, #E0301E 58%, #7A2F9A 83%, #7A1F3D); box-shadow: inset 0 0 0 1px rgba(20, 18, 58, .1); }
  .ph-spec b { position: absolute; left: 0; top: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 3px #F5B700, 0 2px 4px rgba(20, 18, 58, .25); }
  .ph-ticks { position: relative; height: 16px; margin-top: 8px; font-size: 13px; color: var(--mute); }
  .ph-ticks span { position: absolute; top: 0; translate: -50% 0; } .ph-ticks span:first-child { left: 0; translate: 0 0; } .ph-ticks span[style*="right"] { translate: 0 0; }
