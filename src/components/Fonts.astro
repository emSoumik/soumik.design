---
// the site's three typefaces, served from /assets/fonts instead of google's two extra hosts. one file per face and
// alphabet (latin, and latin-ext for the odd accent: a browser fetches a file only when the page uses a letter in its
// unicode-range). each has a fallback sized to its width and line, so the page doesn't jump when the real one lands:
// add "<name> fallback" right after the face in a font stack.
// this renders in <head> of Base.astro and index.astro. `preload` names the faces a page shows above the fold
type Face = 'sans' | 'serif' | 'serif-italic' | 'pixel';
interface Props { preload?: Face[] }
const { preload = ['sans', 'pixel'] } = Astro.props;

const FILE: Record<Face, string> = { sans: 'instrument-sans', serif: 'instrument-serif', 'serif-italic': 'instrument-serif-italic', pixel: 'pixelify-sans' };
const LATIN = 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD';
const EXT = 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF';
const face = (family: string, file: string, rest: string) => [['latin-ext', EXT], ['latin', LATIN]]
  .map(([set, range]) => `@font-face { font-family: "${family}"; ${rest} font-display: swap; src: url(/assets/fonts/${file}-${set}.woff2) format("woff2"); unicode-range: ${range}; }`).join('\n');

const css = `
${face('Instrument Sans', FILE.sans, 'font-style: normal; font-weight: 400 700; font-stretch: 100%;')}
${face('Instrument Serif', FILE['serif-italic'], 'font-style: italic; font-weight: 400;')}
${face('Instrument Serif', FILE.serif, 'font-style: normal; font-weight: 400;')}
${face('Pixelify Sans', FILE.pixel, 'font-style: normal; font-weight: 500 600;')}
/* stand-ins while a face loads: a font the device already has, scaled to the real one's average letter width, with
   its ascent and descent (measured from the font files, over this site's own copy) */
@font-face { font-family: "Instrument Sans fallback"; src: local("Arial"), local("Roboto"); size-adjust: 102.6%; ascent-override: 94.5%; descent-override: 24.4%; line-gap-override: 0%; }
@font-face { font-family: "Instrument Serif fallback"; font-style: normal; src: local("Georgia"); size-adjust: 76.2%; ascent-override: 129.9%; descent-override: 40.7%; line-gap-override: 0%; }
@font-face { font-family: "Instrument Serif fallback"; font-style: italic; src: local("Georgia Italic"), local("Georgia-Italic"); size-adjust: 78.5%; ascent-override: 126.1%; descent-override: 39.5%; line-gap-override: 0%; }
@font-face { font-family: "Pixelify Sans fallback"; src: local("Menlo"), local("Courier New"), local("Droid Sans Mono"), local("Roboto Mono"); size-adjust: 82.6%; ascent-override: 111.4%; descent-override: 33.9%; line-gap-override: 0%; }
`;
---
{preload.map((f) => <link rel="preload" as="font" type="font/woff2" href={`/assets/fonts/${FILE[f]}-latin.woff2`} crossorigin>)}
<style is:inline set:html={css}></style>
