---
// a case study's cover: the desktop screen in a browser window, with up to two phone screens standing in front.
// without phones it's just the image, as before
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Phone from './mdx/Phone.astro';

interface Props { src: ImageMetadata; alt: string; phones?: string[]; link?: string }
const { src, alt, phones = [], link } = Astro.props;
const host = link && new URL(link).hostname;
const sizes = '(min-width: 1140px) 1080px, calc(100vw - 32px)';
---
{phones.length ? (
  <div class="cover composed">
    <div class="win">
      <div class="bar" aria-hidden="true"><span class="dots"><i></i><i></i><i></i></span><span class="url">{host}</span><span></span></div>
      <Picture src={src} alt={alt} widths={[720, src.width]} sizes="(min-width: 1140px) 760px, 70vw" formats={['avif']} fallbackFormat="webp" loading="eager" fetchpriority="high" />
    </div>
    {phones.slice(0, 2).map((p, i) => <Phone src={p} alt="" eager class={i ? 'b' : 'a'} />)}
  </div>
) : (
  <div class="cover"><Picture src={src} alt={alt} widths={[720, src.width]} sizes={sizes} formats={['avif']} fallbackFormat="webp" loading="eager" fetchpriority="high" /></div>
)}

<style>
  .composed { position: relative; container-type: inline-size; aspect-ratio: 16 / 10.4; background: #e9edf4; }
  .composed::before { content: ""; position: absolute; inset: 0;
    background: radial-gradient(80% 70% at 10% 0%, rgba(127, 155, 201, .42), transparent 66%), radial-gradient(70% 70% at 96% 100%, rgba(122, 112, 196, .32), transparent 64%); }
  .win { position: absolute; left: 6cqw; top: 8.5cqw; width: 70cqw; border-radius: 1.4cqw; overflow: hidden; background: #fff;
    box-shadow: 0 0 0 .5px rgba(22, 20, 15, .16), 0 6px 14px -4px rgba(40, 30, 15, .14), 0 28px 52px -18px rgba(40, 30, 15, .34); }
  .win :global(img) { display: block; width: 100%; aspect-ratio: 1200 / 752; object-fit: cover; object-position: top; }
  .bar { height: 3.4cqw; display: grid; grid-template-columns: 1fr minmax(0, 44%) 1fr; align-items: center; padding: 0 1.2cqw; background: #fff; border-bottom: .5px solid rgba(22, 20, 15, .1); }
  .dots { display: flex; gap: .6cqw; }
  .dots i { width: .8cqw; aspect-ratio: 1; border-radius: 50%; background: #d3d0ca; }
  .url { height: 62%; display: flex; align-items: center; justify-content: center; border-radius: 99px; background: rgba(22, 20, 15, .055); font: 500 1.3cqw/1 var(--ui); color: rgba(22, 20, 15, .8); }
  .composed :global(.ph) { position: absolute; width: 17.5cqw; }
  .composed :global(.ph.a) { left: 61cqw; top: 15cqw; }
  .composed :global(.ph.b) { left: 78.5cqw; top: 7.5cqw; }
</style>
