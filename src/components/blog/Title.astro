---
// a post's title, with its one accent word (if it has one) set in italic, like the wordmark
interface Props { text: string; accent?: string }
const { text, accent } = Astro.props;
const at = accent ? text.indexOf(accent) : -1;
---
{at < 0 ? text : <>{text.slice(0, at)}<em>{accent}</em>{text.slice(at + accent!.length)}</>}
