---
// a few of the whyclub shaders on one canvas (js/work/reel.js, the glsl ported as written). it starts when it nears the
// screen, walks through its scenes on its own, and stops walking the moment someone picks one. the pointer tilts the light.
// under reduced motion each scene is one still frame and nothing walks
import { SCENES } from '../../../js/work/reel.js';
interface Props {
  /** [scene index in reel.js, the name on its button] */
  scenes: [number, string][];
  label: string;
  /** set the scene's headline in the corner the shader keeps calm for it (the order pass) */
  heads?: boolean;
}
const { scenes, label, heads = false } = Astro.props;
const first = SCENES[scenes[0][0]];
---
<div class="sh" data-shader data-dark={String(first.dark)}>
  <canvas aria-hidden="true"></canvas>
  <div class="sh-say">
    {heads && <p class="sh-head" data-title aria-live="polite">{first.title}</p>}
    <div class="sh-pick" role="radiogroup" aria-label={label}>
      {scenes.map(([i, name], k) => <button type="button" role="radio" aria-checked={String(k === 0)} tabindex={k === 0 ? 0 : -1} data-i={i}>{name}</button>)}
    </div>
  </div>
  <p class="sh-fail" hidden>This one is drawn with WebGL, and this browser has it switched off.</p>
</div>

<style>
  .sh { position: relative; aspect-ratio: 16 / 9; color: #fff; touch-action: pan-y; }
  .sh[data-dark="false"] { color: #141414; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sh-say { position: absolute; left: clamp(16px, 2.6vw, 32px); right: clamp(16px, 2.6vw, 32px); bottom: clamp(16px, 2.6vw, 28px); display: grid; justify-items: start; gap: 16px; pointer-events: none; }
  .sh-head { font: 600 clamp(30px, 4.4vw, 56px)/1 var(--display); letter-spacing: -.035em; }
  .sh-pick { display: flex; flex-wrap: wrap; gap: 2px; padding: 3px; border-radius: 99px; pointer-events: auto;
    background: rgba(255, 255, 255, .12); -webkit-backdrop-filter: blur(12px) saturate(1.4); backdrop-filter: blur(12px) saturate(1.4); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .12); }
  .sh[data-dark="false"] .sh-pick { background: rgba(255, 255, 255, .55); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .08); }
  .sh-pick button { all: unset; box-sizing: border-box; display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 99px; cursor: pointer;
    font: 500 12.5px/1 var(--display); color: inherit; opacity: .72; transition: background-color .2s, opacity .2s, transform .16s var(--ease); }
  .sh-pick button[aria-checked="true"] { opacity: 1; background: rgba(255, 255, 255, .2); }
  .sh[data-dark="false"] .sh-pick button[aria-checked="true"] { background: #fff; box-shadow: 0 1px 2px rgba(0, 0, 0, .08); }
  .sh-pick button:active { transform: scale(.97); }
  .sh-pick button:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; }
  .sh-fail { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; font: 400 14px/1.5 var(--mono); color: rgba(255, 255, 255, .7); }
  .sh-fail[hidden] { display: none; }
  @media (hover: hover) and (pointer: fine) { .sh-pick button:hover { opacity: 1; } }
  /* a phone gets a taller canvas, so each shader reads whole */
  @media (max-width: 640px) {
    .sh { aspect-ratio: 4 / 5; }
    .sh-pick button { min-height: 40px; padding: 0 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .sh-pick button { transition: none; } }
</style>

<script>
  import { createReel, SCENES } from '../../../js/work/reel.js';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-shader]').forEach((el) => {
    const canvas = el.querySelector('canvas')!;
    const btns = [...el.querySelectorAll<HTMLButtonElement>('[data-i]')];
    const head = el.querySelector<HTMLElement>('[data-title]');
    const list = btns.map((b) => Number(b.dataset.i));
    let reel: ReturnType<typeof createReel> | null = null;
    let at = 0, timer = 0, held = false, seen = false;

    const pick = (k: number, focus = false) => {
      at = k;
      btns.forEach((b, j) => { b.setAttribute('aria-checked', String(j === k)); b.tabIndex = j === k ? 0 : -1; });
      if (focus) btns[k].focus();
      reel?.show(list[k]);
      const s = SCENES[list[k]];
      el.dataset.dark = String(s.dark);
      if (head) head.textContent = s.title;
    };
    // it walks on its own until someone picks a scene; never under reduced motion
    const walk = () => {
      clearInterval(timer);
      if (seen && !held && !reduced) timer = window.setInterval(() => pick((at + 1) % list.length), 4200);
    };
    const take = (k: number, focus = false) => { held = true; clearInterval(timer); pick(k, focus); };

    btns.forEach((b, j) => {
      b.addEventListener('click', () => take(j));
      b.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        take((j + d + list.length) % list.length, true);
      });
    });
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      reel?.setTilt((e.clientX - r.left) / r.width - 0.5, (e.clientY - r.top) / r.height - 0.5);
    });
    el.addEventListener('pointerleave', () => reel?.setTilt(0, 0));

    new IntersectionObserver(([e]) => {
      seen = e.isIntersecting;
      if (seen && !reel) {
        reel = createReel(canvas, { start: list[at], onFail: () => { el.querySelector<HTMLElement>('.sh-fail')!.hidden = false; } });
      }
      walk();
    }, { rootMargin: '15% 0px' }).observe(el);
  });
</script>
